<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create account — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --navy: #070d3f;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --vivid-blue: #1c19b8;
      --white: #ffffff;
      --light-blue: #e0e4f5;

      --ink: var(--deep-navy);
      --muted: #5b6b85;
      --line: var(--light-blue);
      --bg: #f7f9ff;
      --surface: var(--white);

      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 600px at 50% -20%, rgba(44, 131, 248, 0.12), transparent 70%),
        var(--bg);
      line-height: 1.65;
      min-height: 100vh;
      display: grid;
      grid-template-rows: auto 1fr auto;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Header (same as home & login) */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(18px);
      background: rgba(255, 255, 255, 0.85);
      border-bottom: 1px solid var(--light-blue);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .brand-mark {
      width: 44px;
      height: 44px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 12px 32px rgba(44, 131, 248, 0.30);
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 30px;
    }

    .nav a {
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      transition: 0.2s;
    }

    .nav a:hover {
      color: var(--electric-blue);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      border-radius: 999px;
      padding: 14px 27px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.25s ease;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 16px 45px rgba(44, 131, 248, 0.30);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 22px 60px rgba(39, 76, 220, 0.35);
    }

    .btn-outline {
      background: var(--white);
      border: 1px solid var(--light-blue);
      color: var(--deep-navy);
    }

    .btn-outline:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    /* Centered signup layout */
    .signup-wrap {
      display: grid;
      place-items: center;
      padding: 50px 0 80px;
    }

    .signup-box {
      width: min(600px, 100% - 40px);
      text-align: center;
    }

    .signup-logo {
      width: 64px;
      height: 64px;
      margin: 0 auto 18px;
      border-radius: 20px;
      display: grid;
      place-items: center;
      color: var(--white);
      font-family: "Sora", sans-serif;
      font-weight: 800;
      font-size: 26px;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.35);
    }

    .signup-title {
      font-family: "Sora", sans-serif;
      font-size: 32px;
      letter-spacing: -1px;
      color: var(--deep-navy);
      margin-bottom: 8px;
    }

    .signup-sub {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 26px;
    }

    .value-prop {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px 20px;
      text-align: left;
      margin-bottom: 22px;
    }

    .value-prop h2 {
      font-family: "Sora", sans-serif;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
      margin-bottom: 10px;
    }

    .value-prop p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }

    .signup-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 36px 32px;
      text-align: left;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .signup-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 28px 80px rgba(5, 10, 48, 0.14);
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      margin-bottom: 18px;
      position: relative;
    }

    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--deep-navy);
      margin-bottom: 8px;
    }

    .form-input {
      width: 100%;
      padding: 14px 16px;
      padding-right: 44px;
      border: 1px solid var(--line);
      border-radius: 14px;
      font-size: 15px;
      font-family: inherit;
      color: var(--deep-navy);
      background: var(--white);
      transition: 0.2s ease;
    }

    .form-input:focus {
      outline: none;
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .password-wrap {
      position: relative;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: var(--muted);
      cursor: pointer;
      font-size: 18px;
      display: grid;
      place-items: center;
      padding: 6px;
      border-radius: 8px;
      transition: 0.2s;
    }

    .toggle-password:hover {
      color: var(--electric-blue);
      background: rgba(44, 131, 248, 0.08);
    }

    .form-note {
      font-size: 12px;
      color: var(--muted);
      margin-top: 6px;
    }

    .form-actions {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin: 18px 0 22px;
      font-size: 13px;
      color: var(--muted);
    }

    .form-actions a {
      color: var(--electric-blue);
      font-weight: 600;
    }

    .btn-block {
      width: 100%;
    }

    .signup-divider {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 24px 0;
      color: var(--muted);
      font-size: 13px;
    }

    .signup-divider::before,
    .signup-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--line);
    }

    .signup-footer {
      text-align: center;
      font-size: 14px;
      color: var(--muted);
    }

    .signup-footer a {
      color: var(--electric-blue);
      font-weight: 600;
    }

    /* Benefits row under card */
    .benefits-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-top: 22px;
      text-align: left;
    }

    .benefit-mini {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 14px;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .benefit-mini:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 50px rgba(5, 10, 48, 0.10);
    }

    .benefit-mini-icon {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      font-size: 16px;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 8px 20px rgba(44, 131, 248, 0.25);
      flex: 0 0 34px;
    }

    .benefit-mini-text strong {
      display: block;
      font-size: 13px;
      color: var(--deep-navy);
      margin-bottom: 2px;
    }

    .benefit-mini-text span {
      font-size: 12px;
      color: var(--muted);
    }

    /* Trusted strip */
    .trusted-strip {
      margin-top: 26px;
      text-align: center;
    }

    .trusted-label {
      font-size: 12px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 12px;
    }

    .trusted-logos {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      color: var(--muted);
      font-family: "Sora", sans-serif;
      font-weight: 700;
      font-size: 13px;
    }

    .trusted-logos span {
      padding: 6px 10px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--white);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .trusted-logos span:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 40px rgba(5, 10, 48, 0.08);
    }

    /* Footer (same as home & login) */
    .footer {
      background: var(--deep-navy);
      border-top: 1px solid rgba(224, 228, 245, 0.15);
      padding: 34px 0;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.70);
    }

    .footer-links {
      display: flex;
      gap: 22px;
    }

    .footer a:hover {
      color: var(--electric-blue);
    }

    /* Animations */
    .reveal-up {
      opacity: 0;
      transform: translateY(18px);
      animation: revealUp 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.08s;
    }

    .delay-2 {
      animation-delay: 0.16s;
    }

    .delay-3 {
      animation-delay: 0.24s;
    }

    .delay-4 {
      animation-delay: 0.32s;
    }

    .delay-5 {
      animation-delay: 0.40s;
    }

    .delay-6 {
      animation-delay: 0.48s;
    }

    .fade-in {
      opacity: 0;
      animation: fadeIn 0.8s ease forwards;
    }

    @keyframes fadeIn {
      to {
        opacity: 1;
      }
    }

    /* Responsive */
    @media (max-width: 700px) {
      .form-grid {
        grid-template-columns: 1fr;
      }

      .benefits-row {
        grid-template-columns: 1fr;
      }

      .nav {
        display: none;
      }
    }
  </style>
</head>

<body>
  <!-- Header -->
  <header class="header">
    <div class="container header-inner">
      <div class="brand">
        <div class="brand-mark">V</div>
        VentrixCarros
      </div>

      <nav class="nav">
        <a href="index.html">Home</a>
        <a href="login.html">Log in</a>
        <a href="index.html" class="btn btn-outline">Back to site</a>
      </nav>
    </div>
  </header>

  <!-- Centered Signup -->
  <main class="signup-wrap">
    <div class="signup-box">
      <div class="signup-logo reveal-up">V</div>
      <h1 class="signup-title reveal-up delay-1">Create your company account</h1>
      <p class="signup-sub reveal-up delay-2">
        Get started with VentrixCarros in minutes
      </p>

      <!-- Value prop / intro content -->
      <div class="value-prop fade-in delay-3">
        <h2>Why companies use VentrixCarros</h2>
        <p>
          VentrixCarros brings jobs, candidates, applications, interviews, and
          hiring insights into one clean dashboard. Recruiters save time on
          manual screening, collaborate faster, and make data-driven hiring
          decisions — from first application to final offer.
        </p>
      </div>

      <div class="signup-card fade-in delay-4">
        <form id="signupForm">
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="companyName">Company name</label>
              <input
                class="form-input"
                type="text"
                id="companyName"
                name="companyName"
                placeholder="Your Company Ltd."
                required
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="workEmail">Work email</label>
              <input
                class="form-input"
                type="email"
                id="workEmail"
                name="workEmail"
                placeholder="you@company.com"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="fullName">Full name</label>
            <input
              class="form-input"
              type="text"
              id="fullName"
              name="fullName"
              placeholder="Your name"
              required
            />
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label" for="password">Password</label>
              <div class="password-wrap">
                <!-- Visible by default -->
                <input
                  class="form-input"
                  type="text"
                  id="password"
                  name="password"
                  placeholder="Create a password"
                  required
                />
                <button
                  type="button"
                  class="toggle-password"
                  id="togglePassword"
                  title="Hide password"
                >
                  🙈
                </button>
              </div>
              <p class="form-note">At least 8 characters</p>
            </div>

            <div class="form-group">
              <label class="form-label" for="confirmPassword">Confirm password</label>
              <div class="password-wrap">
                <input
                  class="form-input"
                  type="text"
                  id="confirmPassword"
                  name="confirmPassword"
                  placeholder="Re-enter password"
                  required
                />
                <button
                  type="button"
                  class="toggle-password"
                  id="toggleConfirmPassword"
                  title="Hide password"
                >
                  🙈
                </button>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <input type="checkbox" id="terms" required />
            <label for="terms">
              I agree to the
              <a href="#">Terms of Service</a>
              and
              <a href="#">Privacy Policy</a>.
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Create account
          </button>
        </form>

        <div class="signup-divider">or</div>

        <div class="signup-footer">
          Already have an account?
          <a href="login.html">Log in</a>
        </div>
      </div>

      <!-- Benefits row -->
      <div class="benefits-row">
        <div class="benefit-mini fade-in delay-4">
          <div class="benefit-mini-icon">⚡</div>
          <div class="benefit-mini-text">
            <strong>AI screening</strong>
            <span>Auto-rank candidates by fit</span>
          </div>
        </div>

        <div class="benefit-mini fade-in delay-5">
          <div class="benefit-mini-icon">📊</div>
          <div class="benefit-mini-text">
            <strong>Analytics</strong>
            <span>Track applications & hires</span>
          </div>
        </div>

        <div class="benefit-mini fade-in delay-6">
          <div class="benefit-mini-icon">🔒</div>
          <div class="benefit-mini-text">
            <strong>Secure</strong>
            <span>Private company data</span>
          </div>
        </div>
      </div>

      <!-- Trusted strip -->
      <div class="trusted-strip fade-in delay-6">
        <div class="trusted-label">Trusted by hiring teams at</div>
        <div class="trusted-logos">
          <span>StartupHub</span>
          <span>TechNest</span>
          <span>HirePro</span>
          <span>GrowthLab</span>
          <span>TalentX</span>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-inner">
      <p>© 2026 VentrixCarros. All rights reserved.</p>

      <div class="footer-links">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms</a>
        <a href="#">Support</a>
      </div>
    </div>
  </footer>

  <script>
    // Toggle password visibility (default: visible)
    function setupTogglePassword(inputId, buttonId) {
      const toggle = document.getElementById(buttonId);
      const input = document.getElementById(inputId);

      toggle.addEventListener("click", () => {
        const isCurrentlyVisible = input.type === "text";
        input.type = isCurrentlyVisible ? "password" : "text";
        toggle.textContent = isCurrentlyVisible ? "👁" : "🙈";
        toggle.title = isCurrentlyVisible ? "Show password" : "Hide password";
      });
    }

    setupTogglePassword("password", "togglePassword");
    setupTogglePassword("confirmPassword", "toggleConfirmPassword");

    // Demo signup handler
    const signupForm = document.getElementById("signupForm");
    signupForm.addEventListener("submit", (e) => {
      e.preventDefault();

      const data = {
        companyName: document.getElementById("companyName").value,
        workEmail: document.getElementById("workEmail").value,
        fullName: document.getElementById("fullName").value,
        password: document.getElementById("password").value,
        confirmPassword: document.getElementById("confirmPassword").value,
      };

      // Basic validation
      if (data.password.length < 8) {
        alert("Password must be at least 8 characters.");
        return;
      }

      if (data.password !== data.confirmPassword) {
        alert("Passwords do not match.");
        return;
      }

      // TODO: Replace with real signup / API call
      console.log("Signup attempt:", data);
      alert("Demo signup: check console for submitted data.");
    });
  </script>
</body>
</html>