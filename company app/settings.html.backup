<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Settings — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --navy: #070d3f;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --vivid-blue: #1c19b8;
      --white: #ffffff;
      --light-blue: #e0e4f5;

      --ink: var(--deep-navy);
      --muted: #5b6b85;
      --line: var(--light-blue);
      --bg: #f7f9ff;
      --surface: var(--white);

      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 600px at 50% -20%, rgba(44, 131, 248, 0.08), transparent 70%),
        var(--bg);
      line-height: 1.65;
      min-height: 100vh;
      overflow-x: hidden;
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      background: var(--white);
      border-right: 1px solid var(--line);
      padding: 20px 16px;
      overflow-y: auto;
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
      padding: 10px 12px;
      margin-bottom: 18px;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.30);
      font-size: 18px;
    }

    .nav-list {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      transition: 0.2s ease;
      cursor: pointer;
    }

    .nav-item:hover {
      background: rgba(44, 131, 248, 0.06);
      color: var(--electric-blue);
    }

    .nav-item.active {
      background: linear-gradient(135deg, rgba(44, 131, 248, 0.12), rgba(39, 76, 220, 0.12));
      color: var(--royal-blue);
      font-weight: 600;
    }

    .nav-icon {
      width: 22px;
      text-align: center;
      font-size: 16px;
    }

    .nav-section {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .nav-section-title {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      padding: 6px 12px;
      margin-bottom: 6px;
    }

    /* Main content */
    .main-content {
      min-width: 0;
    }

    /* Top header */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(247, 249, 255, 0.85);
      border-bottom: 1px solid var(--line);
      padding: 14px 0;
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--deep-navy);
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: 0.2s ease;
      text-decoration: none;
    }

    .back-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateX(-2px);
    }

    .page-title {
      font-family: "Sora", sans-serif;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .search-wrap {
      flex: 1;
      max-width: 420px;
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-size: 14px;
      font-family: inherit;
      color: var(--deep-navy);
      background: var(--white);
      transition: 0.2s ease;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 15px;
      color: var(--muted);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--white);
      display: grid;
      place-items: center;
      font-size: 17px;
      color: var(--muted);
      cursor: pointer;
      transition: 0.2s;
    }

    .icon-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .avatar-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      color: var(--white);
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(44, 131, 248, 0.25);
    }

    /* Page content */
    .page-wrap {
      padding: 28px 0 60px;
    }

    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 18px;
    }

    .page-title-large {
      font-family: "Sora", sans-serif;
      font-size: 26px;
      letter-spacing: -1px;
      color: var(--deep-navy);
    }

    .page-sub {
      font-size: 13px;
      color: var(--muted);
    }

    .actions-right {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      border-radius: 999px;
      padding: 11px 18px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.25s ease;
      font-family: inherit;
      font-size: 13px;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.30);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 55px rgba(39, 76, 220, 0.35);
    }

    .btn-outline {
      background: var(--white);
      border: 1px solid var(--line);
      color: var(--deep-navy);
    }

    .btn-outline:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .btn-danger {
      color: var(--white);
      background: linear-gradient(135deg, #dc2626, #991b1b);
      box-shadow: 0 14px 40px rgba(220, 38, 38, 0.30);
    }

    .btn-danger:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 55px rgba(220, 38, 38, 0.35);
    }

    /* Tabs */
    .tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .tab {
      padding: 9px 16px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--muted);
      cursor: pointer;
      transition: 0.2s;
    }

    .tab.active {
      background: linear-gradient(135deg, rgba(44, 131, 248, 0.12), rgba(39, 76, 220, 0.12));
      border-color: rgba(44, 131, 248, 0.35);
      color: var(--royal-blue);
    }

    /* Panels */
    .panel {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
      margin-bottom: 18px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .panel-title {
      font-family: "Sora", sans-serif;
      font-size: 18px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .panel-sub {
      font-size: 12px;
      color: var(--muted);
    }

    /* Forms */
    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--deep-navy);
      margin-bottom: 8px;
    }

    .form-input,
    .form-select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      font-size: 14px;
      font-family: inherit;
      color: var(--deep-navy);
      background: var(--white);
      transition: 0.2s ease;
    }

    .form-input:focus,
    .form-select:focus {
      outline: none;
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    /* Toggle row */
    .toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--white);
      margin-bottom: 10px;
    }

    .toggle-info strong {
      display: block;
      font-size: 13px;
      color: var(--deep-navy);
      margin-bottom: 3px;
    }

    .toggle-info span {
      font-size: 12px;
      color: var(--muted);
    }

    .toggle-switch {
      width: 44px;
      height: 26px;
      border-radius: 999px;
      background: #cbd5e1;
      position: relative;
      cursor: pointer;
      transition: 0.2s;
    }

    .toggle-switch.active {
      background: var(--electric-blue);
    }

    .toggle-knob {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--white);
      position: absolute;
      top: 3px;
      left: 3px;
      transition: 0.2s;
      box-shadow: 0 2px 6px rgba(0,0,0,0.25);
    }

    .toggle-switch.active .toggle-knob {
      left: 21px;
    }

    /* Integrations */
    .integration-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--white);
      margin-bottom: 10px;
    }

    .integration-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .integration-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-size: 18px;
      background: rgba(44, 131, 248, 0.08);
      color: var(--royal-blue);
      border: 1px solid rgba(44, 131, 248, 0.20);
    }

    .integration-name strong {
      display: block;
      font-size: 13px;
      color: var(--deep-navy);
      margin-bottom: 2px;
    }

    .integration-name span {
      font-size: 11px;
      color: var(--muted);
    }

    /* Animations */
    .reveal-up {
      opacity: 0;
      transform: translateY(16px);
      animation: revealUp 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.06s;
    }

    .delay-2 {
      animation-delay: 0.12s;
    }

    .delay-3 {
      animation-delay: 0.18s;
    }

    /* Responsive */
    @media (max-width: 1000px) {
      body {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: relative;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      .nav-list {
        grid-template-columns: repeat(2, 1fr);
      }

      .form-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .nav-list {
        grid-template-columns: 1fr;
      }

      .search-wrap {
        order: 3;
        max-width: 100%;
        margin: 10px 0 0;
        width: 100%;
      }

      .topbar-inner {
        flex-wrap: wrap;
      }

      .tabs {
        gap: 6px;
      }

      .tab {
        padding: 8px 12px;
        font-size: 12px;
      }
    }
  </style>
</head>

<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">V</div>
      <span>VENTRIXCARROS</span>
    </div>

    <nav class="nav-list">
      <a href="dashboard.html" class="nav-item">
        <span class="nav-icon">🏠</span>
        Dashboard
      </a>
      <a href="ai-recruitment.html" class="nav-item">
        <span class="nav-icon">🤖</span>
        AI Recruitment
      </a>
      <a href="jobs.html" class="nav-item">
        <span class="nav-icon">💼</span>
        Jobs
      </a>
      <a href="candidates.html" class="nav-item">
        <span class="nav-icon">👥</span>
        Candidates
      </a>
      <a href="applications.html" class="nav-item">
        <span class="nav-icon">📋</span>
        Applications
      </a>
      <a href="shortlisted.html" class="nav-item">
        <span class="nav-icon">⭐</span>
        Shortlisted
      </a>
      <a href="interviews.html" class="nav-item">
        <span class="nav-icon">🎤</span>
        Interviews
      </a>
      <a href="messages.html" class="nav-item">
        <span class="nav-icon">💬</span>
        Messages
      </a>
      <a href="analytics.html" class="nav-item">
        <span class="nav-icon">📊</span>
        Analytics
      </a>

      <div class="nav-section">
        <div class="nav-section-title">Account</div>
        <a href="subscription.html" class="nav-item">
          <span class="nav-icon">💳</span>
          Subscription
        </a>
        <a href="company-profile.html" class="nav-item">
          <span class="nav-icon">🏢</span>
          Company Profile
        </a>
        <div class="nav-item active">
          <span class="nav-icon">⚙️</span>
          Settings
        </div>
        <a href="index.html" class="nav-item">
          <span class="nav-icon">🚪</span>
          Logout
        </a>
      </div>
    </nav>
  </aside>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <!-- Back to dashboard -->
          <a href="dashboard.html" class="back-btn">
            ← Back
          </a>
          <div class="page-title">Settings</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            class="search-input"
            type="text"
            placeholder="Search settings..."
          />
        </div>

        <div class="nav-right">
          <button class="icon-btn" title="Notifications">🔔</button>
          <div class="avatar-btn" title="Profile">VC</div>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="page-wrap">
      <div class="container">
        <!-- Page head -->
        <div class="page-head reveal-up">
          <div>
            <h1 class="page-title-large">Settings</h1>
            <p class="page-sub">
              Manage your account preferences, notifications, integrations, and security.
            </p>
          </div>

          <div class="actions-right">
            <button class="btn btn-outline">📥 Export my data</button>
            <button class="btn btn-primary">💾 Save changes</button>
          </div>
        </div>

        <!-- Tabs -->
        <div class="tabs reveal-up delay-1">
          <div class="tab active" data-tab="general">General</div>
          <div class="tab" data-tab="notifications">Notifications</div>
          <div class="tab" data-tab="integrations">Integrations</div>
          <div class="tab" data-tab="privacy">Privacy & Security</div>
        </div>

        <!-- General -->
        <section class="panel reveal-up delay-2" id="general-panel">
          <div class="panel-head">
            <div>
              <div class="panel-title">General settings</div>
              <div class="panel-sub">Profile, email, time zone, and language</div>
            </div>
          </div>

          <form>
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="fullName">Full name</label>
                <input
                  class="form-input"
                  type="text"
                  id="fullName"
                  value="Amit Verma"
                />
              </div>

              <div class="form-group">
                <label class="form-label" for="email">Email address</label>
                <input
                  class="form-input"
                  type="email"
                  id="email"
                  value="amit@ventrixcarros.com"
                />
              </div>
            </div>

            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="timeZone">Time zone</label>
                <select class="form-select" id="timeZone">
                  <option>Asia/Kolkata (IST)</option>
                  <option>America/New_York (EST)</option>
                  <option>Europe/London (GMT)</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="language">Language</label>
                <select class="form-select" id="language">
                  <option>English</option>
                  <option>Hindi</option>
                  <option>Spanish</option>
                </select>
              </div>
            </div>
          </form>
        </section>

        <!-- Notifications -->
        <section class="panel reveal-up delay-2" id="notifications-panel" style="display:none;">
          <div class="panel-head">
            <div>
              <div class="panel-title">Notifications</div>
              <div class="panel-sub">Choose what you want to be notified about</div>
            </div>
          </div>

          <div class="toggle-row">
            <div class="toggle-info">
              <strong>New applications</strong>
              <span>Email me when a candidate applies to any job</span>
            </div>
            <div class="toggle-switch active" onclick="this.classList.toggle('active')">
              <div class="toggle-knob"></div>
            </div>
          </div>

          <div class="toggle-row">
            <div class="toggle-info">
              <strong>Interview reminders</strong>
              <span>Send reminders before scheduled interviews</span>
            </div>
            <div class="toggle-switch active" onclick="this.classList.toggle('active')">
              <div class="toggle-knob"></div>
            </div>
          </div>

          <div class="toggle-row">
            <div class="toggle-info">
              <strong>Weekly summary</strong>
              <span>Weekly email with hiring stats and insights</span>
            </div>
            <div class="toggle-switch" onclick="this.classList.toggle('active')">
              <div class="toggle-knob"></div>
            </div>
          </div>

          <div class="toggle-row">
            <div class="toggle-info">
              <strong>Product updates</strong>
              <span>Emails about new features and improvements</span>
            </div>
            <div class="toggle-switch active" onclick="this.classList.toggle('active')">
              <div class="toggle-knob"></div>
            </div>
          </div>
        </section>

        <!-- Integrations -->
        <section class="panel reveal-up delay-2" id="integrations-panel" style="display:none;">
          <div class="panel-head">
            <div>
              <div class="panel-title">Integrations</div>
              <div class="panel-sub">Connect your favorite tools</div>
            </div>
          </div>

          <div class="integration-row">
            <div class="integration-info">
              <div class="integration-icon">📅</div>
              <div class="integration-name">
                <strong>Google Calendar</strong>
                <span>Sync interviews with your calendar</span>
              </div>
            </div>
            <button class="btn btn-outline btn-sm">Connect</button>
          </div>

          <div class="integration-row">
            <div class="integration-info">
              <div class="integration-icon">📨</div>
              <div class="integration-name">
                <strong>Email (SMTP)</strong>
                <span>Send emails from your company domain</span>
              </div>
            </div>
            <button class="btn btn-outline btn-sm">Configure</button>
          </div>

          <div class="integration-row">
            <div class="integration-info">
              <div class="integration-icon">🧩</div>
              <div class="integration-name">
                <strong>ATS Integration</strong>
                <span>Push hired candidates to your ATS</span>
              </div>
            </div>
            <button class="btn btn-outline btn-sm">Connect</button>
          </div>

          <div class="integration-row">
            <div class="integration-info">
              <div class="integration-icon">🌐</div>
              <div class="integration-name">
                <strong>Job Boards</strong>
                <span>Publish jobs to external boards automatically</span>
              </div>
            </div>
            <button class="btn btn-outline btn-sm">Manage</button>
          </div>
        </section>

        <!-- Privacy & Security -->
        <section class="panel reveal-up delay-2" id="privacy-panel" style="display:none;">
          <div class="panel-head">
            <div>
              <div class="panel-title">Privacy & Security</div>
              <div class="panel-sub">Password, 2FA, and account actions</div>
            </div>
          </div>

          <form>
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="currentPassword">Current password</label>
                <input class="form-input" type="password" id="currentPassword" />
              </div>

              <div class="form-group">
                <label class="form-label" for="newPassword">New password</label>
                <input class="form-input" type="password" id="newPassword" />
              </div>
            </div>

            <div style="margin-bottom:18px;">
              <button class="btn btn-outline btn-sm" type="button">Update password</button>
            </div>
          </form>

          <div class="toggle-row">
            <div class="toggle-info">
              <strong>Two-factor authentication (2FA)</strong>
              <span>Add an extra layer of security to your account</span>
            </div>
            <button class="btn btn-outline btn-sm">Enable 2FA</button>
          </div>

          <div style="margin-top:18px; display:grid; gap:10px;">
            <button class="btn btn-outline">📥 Download my data</button>
            <button class="btn btn-danger">🗑️ Delete my account</button>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    // Highlight active nav item based on current page
    const currentPage = window.location.pathname.split('/').pop() || 'settings.html';
    document.querySelectorAll('.nav-item').forEach(item => {
      const href = item.getAttribute('href') || '';
      if (href === currentPage) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }

      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
      });
    });

    // Tab switching
    const tabs = document.querySelectorAll('.tab');
    const panels = {
      general: document.getElementById('general-panel'),
      notifications: document.getElementById('notifications-panel'),
      integrations: document.getElementById('integrations-panel'),
      privacy: document.getElementById('privacy-panel'),
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const target = tab.dataset.tab;
        Object.keys(panels).forEach(key => {
          panels[key].style.display = key === target ? 'block' : 'none';
        });
      });
    });

    // Demo: wire save / export buttons
    document.querySelectorAll('.btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const text = e.target.textContent.trim();
        if (text.includes('Save') || text.includes('Export') || text.includes('Delete')) {
          console.log('Action:', text);
          alert(`Action: ${text}\n\n(Connect to your backend to implement.)`);
        }
      });
    });
  </script>
</body>
</html>