          Settings
        </a>
        <a href="index.html" class="nav-item">
          <span class="nav-icon">🚪</span>
          Logout
        </a>
      </div>
    </nav>
  </aside>

  <div class="main-content">
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <a href="jobs.html" class="back-btn">← Back</a>
          <div class="page-title">Job Details</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            class="search-input"
            type="text"
            placeholder="Search jobs or candidates..."
          />
        </div>

        <div class="nav-right">
          <button class="icon-btn" id="notificationButton">🔔</button>
          <div class="avatar-btn">VC</div>
        </div>
      </div>
    </header>

    <main class="page-wrap">
      <div class="container">
        <section class="job-header reveal-up">
          <div>
            <h1 class="job-title">Frontend Developer</h1>
            <p class="job-meta">
              Engineering · Remote · Full-time · Posted October 1, 2026
            </p>

            <div class="job-badges">
              <span class="status-pill status-active">● Active</span>
              <span class="badge">React</span>
              <span class="badge">TypeScript</span>
              <span class="badge">3–5 years</span>
            </div>
          </div>

          <div class="job-actions">
            <button class="btn btn-outline" id="previewButton">👁 Preview</button>
            <button class="btn btn-outline" id="editButton">✏️ Edit job</button>
            <button class="btn btn-primary" id="screenButton">🤖 Run AI screening</button>
          </div>
        </section>

        <div class="metrics-grid reveal-up delay-1">
          <div class="metric-card">
            <div class="metric-label">Applications</div>
            <div class="metric-value">42</div>
          </div>

          <div class="metric-card">
            <div class="metric-label">Screened</div>
            <div class="metric-value">31</div>
          </div>

          <div class="metric-card">
            <div class="metric-label">Shortlisted</div>
            <div class="metric-value">12</div>
          </div>

          <div class="metric-card">
            <div class="metric-label">Interviews</div>
            <div class="metric-value">5</div>
          </div>
        </div>

        <div class="content-grid">
          <div>
            <section class="panel reveal-up delay-1">
              <div class="panel-head">
                <div>
                  <h2 class="panel-title">Job description</h2>
                  <p class="panel-sub">Current published description</p>
                </div>
                <button class="btn btn-outline btn-sm" id="optimizeButton">
                  ✨ Optimize with AI
                </button>
              </div>

              <div class="description">
                <h3>About the role</h3>
                <p>
                  We are looking for a talented Frontend Developer to join our
                  product engineering team. You will build responsive,
                  accessible, and high-performance interfaces for our hiring
                  platform.
                </p>

                <h3>Responsibilities</h3>
                <ul>
                  <li>Build and maintain modern React applications.</li>
                  <li>Collaborate with product designers and backend engineers.</li>
                  <li>Write clean, testable, and maintainable code.</li>
                  <li>Improve application performance and user experience.</li>
                </ul>

                <h3>Requirements</h3>
                <ul>
                  <li>3–5 years of frontend development experience.</li>
                  <li>Strong knowledge of React and TypeScript.</li>
                  <li>Experience with responsive UI development.</li>
                  <li>Familiarity with testing tools and Git.</li>
                </ul>
              </div>
            </section>

            <section class="panel reveal-up delay-2">
              <div class="panel-head">
                <div>
                  <h2 class="panel-title">Recent applications</h2>
                  <p class="panel-sub">Candidates applying for this job</p>
                </div>
                <a href="applications.html" class="btn btn-outline btn-sm">
                  View all
                </a>
              </div>

              <div class="table-wrap">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Candidate</th>
                      <th>Applied</th>
                      <th>AI score</th>
                      <th>Stage</th>
                      <th></th>
                    </tr>
                  </thead>

                  <tbody>
                    <tr>
                      <td>
                        <div class="candidate">
                          <div class="candidate-avatar">RS</div>
                          <div>
                            <strong>Rahul Sharma</strong>
                            <span>React · TypeScript</span>
                          </div>
                        </div>
                      </td>
                      <td>Oct 2, 2026</td>
                      <td>
                        <span class="score-pill score-high">92%</span>
                      </td>
                      <td>
                        <span class="status-pill stage-shortlisted">
                          Shortlisted
                        </span>
                      </td>
                      <td>
                        <a href="candidate-detail.html" class="btn btn-outline btn-sm">
                          View
                        </a>
                      </td>
                    </tr>

                    <tr>
                      <td>
                        <div class="candidate">
                          <div class="candidate-avatar">AM</div>
                          <div>
                            <strong>Arjun Mehta</strong>
                            <span>React · JavaScript</span>
                          </div>
                        </div>
                      </td>
                      <td>Oct 4, 2026</td>
                      <td>
                        <span class="score-pill score-medium">78%</span>
                      </td>
                      <td>
                        <span class="status-pill stage-new">New</span>
                      </td>
                      <td>
                        <a href="candidate-detail.html" class="btn btn-outline btn-sm">
                          View
                        </a>
                      </td>
                    </tr>

                    <tr>
                      <td>
                        <div class="candidate">
                          <div class="candidate-avatar">MK</div>
                          <div>
                            <strong>Meera Kulkarni</strong>
                            <span>React · Next.js</span>
                          </div>
                        </div>
                      </td>
                      <td>Oct 6, 2026</td>
                      <td>
                        <span class="score-pill score-high">87%</span>
                      </td>
                      <td>
                        <span class="status-pill stage-shortlisted">
                          Shortlisted
                        </span>
                      </td>
                      <td>
                        <a href="candidate-detail.html" class="btn btn-outline btn-sm">
                          View
                        </a>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </section>
          </div>

          <aside>
            <section class="panel reveal-up delay-2">
              <div class="panel-head">
                <div>
                  <h2 class="panel-title">AI job insights</h2>
                  <p class="panel-sub">Recommendations for this role</p>
                </div>
                <span class="badge">● AI active</span>
              </div>

              <div class="ai-box">
                <div class="ai-icon">🎯</div>
                <div>
                  <strong>Strong candidate response</strong>
                  <span>
                    This job has received 42 applications. React and TypeScript
                    requirements are attracting relevant candidates.
                  </span>
                </div>
              </div>

              <div class="ai-box" style="margin-top:12px;">
                <div class="ai-icon">✨</div>
                <div>
                  <strong>Improve the job description</strong>
                  <span>
                    Adding salary information and benefits may increase qualified
                    applications.
                  </span>
                </div>
              </div>
            </section>

            <section class="panel reveal-up delay-3">
              <div class="panel-head">
                <div>
                  <h2 class="panel-title">Required skills</h2>
                  <p class="panel-sub">Skills used for AI matching</p>
                </div>
                <button class="btn btn-outline btn-sm">Edit</button>
              </div>

              <div class="tag-list">
                <span class="tag">React</span>
                <span class="tag">TypeScript</span>
                <span class="tag">JavaScript</span>
                <span class="tag">HTML/CSS</span>
                <span class="tag">Testing</span>
                <span class="tag">Git</span>
              </div>
            </section>

            <section class="panel reveal-up delay-3">
              <div class="panel-head">
                <div>
                  <h2 class="panel-title">Job settings</h2>
                  <p class="panel-sub">Manage job visibility and status</p>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="jobStatus">Job status</label>
                <select class="form-select" id="jobStatus">
                  <option selected>Active</option>
                  <option>Draft</option>
                  <option>Paused</option>
                  <option>Closed</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="closingDate">Closing date</label>
                <input
                  class="form-input"
                  type="date"
                  id="closingDate"
                  value="2026-11-15"
                />
              </div>

              <button class="btn btn-primary" id="saveButton" style="width:100%;">
                Save settings
              </button>
            </section>
          </aside>
        </div>
      </div>
    </main>
  </div>

  <script>
    function demoAlert(message) {
      alert(`${message}\n\nConnect this action to your backend.`);
    }

    document
      .getElementById("previewButton")
      .addEventListener("click", () => {
        demoAlert("Opening public job preview.");
      });

    document
      .getElementById("editButton")
      .addEventListener("click", () => {
        demoAlert("Opening job editor.");
      });

    document
      .getElementById("screenButton")
      .addEventListener("click", () => {
        demoAlert("AI screening started for Frontend Developer.");
      });

    document
      .getElementById("optimizeButton")
      .addEventListener("click", () => {
        demoAlert("AI is preparing job-description recommendations.");
      });

    document
      .getElementById("saveButton")
      .addEventListener("click", () => {
        const status = document.getElementById("jobStatus").value;
        const closingDate = document.getElementById("closingDate").value;

        alert(
          `Job settings saved in demo mode.\n\nStatus: ${status}\nClosing date: ${closingDate}`
        );
      });

    document
      .getElementById("notificationButton")
      .addEventListener("click", () => {
        alert("You have 3 new notifications.");
      });
  </script>
</body>
</html>