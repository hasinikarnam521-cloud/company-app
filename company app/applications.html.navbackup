<circle cx="12" cy="12" r="3"></circle>
<path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20h-2.6v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2.6h.4A1.7 1.7 0 0 0 8 10a1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V5H15v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.4V14h-.4a1.7 1.7 0 0 0-1.6 1z"></path>
</svg>
</span>
          Settings
        </a>

        <a href="index.html" class="nav-item">
          <span class="nav-icon">🚪</span>
          Logout
        </a>
      </div>
    </nav>
  </aside>

  <div class="main-content">
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <a href="dashboard.html" class="back-btn">← Back</a>
          <div class="page-title">Applications</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            id="applicationSearch"
            class="search-input"
            type="search"
            placeholder="Search by candidate, role, or job..."
          />
        </div>

        <div class="nav-right">
          <button id="notificationButton" class="icon-btn">🔔</button>
          <div class="avatar-btn">VC</div>
        </div>
      </div>
    </header>

    <main class="page-wrap">
      <div class="container">
        <section class="page-head reveal-up">
          <div>
            <h1 class="page-heading">Job applications</h1>
            <p class="page-sub">
              Track every application across your active hiring roles.
            </p>
          </div>

          <div class="head-actions">
            <a href="jobs.html" class="btn btn-primary">
              ➕ Post a job
            </a>

            <button id="exportButton" class="btn btn-outline">
              ⬇ Export list
            </button>
          </div>
        </section>

        <section class="stats-grid">
          <div class="stat-card reveal-up delay-1">
            <div class="stat-label">Total applications</div>
            <div class="stat-value">184</div>
            <div class="stat-note note-up">↑ 28 this week</div>
          </div>

          <div class="stat-card reveal-up delay-2">
            <div class="stat-label">New</div>
            <div class="stat-value">36</div>
            <div class="stat-note">Awaiting review</div>
          </div>

          <div class="stat-card reveal-up delay-3">
            <div class="stat-label">In interview</div>
            <div class="stat-value">18</div>
            <div class="stat-note note-warning">5 scheduled today</div>
          </div>

          <div class="stat-card reveal-up delay-3">
            <div class="stat-label">Offers sent</div>
            <div class="stat-value">4</div>
            <div class="stat-note note-up">1 accepted</div>
          </div>
        </section>

        <section class="filters reveal-up delay-2">
          <select id="jobFilter" class="filter-select">
            <option value="">All jobs</option>
            <option value="frontend-developer">Frontend Developer</option>
            <option value="ai-engineer">AI Engineer</option>
            <option value="backend-engineer">Backend Engineer</option>
          </select>

          <select id="statusFilter" class="filter-select">
            <option value="">All statuses</option>
            <option value="New">New</option>
            <option value="Screened">Screened</option>
            <option value="Interview">Interview</option>
            <option value="Offer">Offer</option>
            <option value="Rejected">Rejected</option>
          </select>

          <select id="scoreFilter" class="filter-select">
            <option value="">All AI scores</option>
            <option value="high">High match (85%+)</option>
            <option value="medium">Medium match (70–84%)</option>
          </select>

          <button id="resetFilters" class="btn btn-outline btn-sm filter-reset">
            Reset filters
          </button>
        </section>

        <section class="panel reveal-up delay-3">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Application tracker</h2>
              <p class="panel-sub">
                Click a candidate to open their detailed profile
              </p>
            </div>

            <span class="ai-badge">● AI ranked</span>
          </div>

          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Candidate</th>
                  <th>Applied for</th>
                  <th>AI score</th>
                  <th>Status</th>
                  <th>Applied on</th>
                  <th>Actions</th>
                </tr>
              </thead>

              <tbody id="applicationRows">
                <tr
                  class="application-row"
                  data-candidate="rahul-sharma"
                  data-job="frontend-developer"
                  data-status="Screened"
                  data-score="high"
                >
                  <td>
                    <div class="candidate-cell">
                      <div class="candidate-avatar">RS</div>

                      <div>
                        <span class="candidate-name">Rahul Sharma</span>
                        <span class="candidate-sub">
                          rahul.sharma@example.com
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>Frontend Developer</td>

                  <td>
                    <span class="score-high">92%</span>
                  </td>

                  <td>
                    <span class="pill pill-screened">Screened</span>
                  </td>

                  <td>Oct 2, 2026</td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="btn btn-outline btn-sm"
                      >
                        View
                      </button>
                    </div>
                  </td>
                </tr>

                <tr
                  class="application-row"
                  data-candidate="priya-nair"
                  data-job="ai-engineer"
                  data-status="Interview"
                  data-score="high"
                >
                  <td>
                    <div class="candidate-cell">
                      <div class="candidate-avatar">PN</div>

                      <div>
                        <span class="candidate-name">Priya Nair</span>
                        <span class="candidate-sub">
                          priya.nair@example.com
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>AI Engineer</td>

                  <td>
                    <span class="score-high">89%</span>
                  </td>

                  <td>
                    <span class="pill pill-interview">Interview</span>
                  </td>

                  <td>Oct 3, 2026</td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="btn btn-outline btn-sm"
                      >
                        View
                      </button>
                    </div>
                  </td>
                </tr>

                <tr
                  class="application-row"
                  data-candidate="arjun-mehta"
                  data-job="frontend-developer"
                  data-status="New"
                  data-score="medium"
                >
                  <td>
                    <div class="candidate-cell">
                      <div class="candidate-avatar">AM</div>

                      <div>
                        <span class="candidate-name">Arjun Mehta</span>
                        <span class="candidate-sub">
                          arjun.mehta@example.com
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>Frontend Developer</td>

                  <td>
                    <span class="score-medium">78%</span>
                  </td>

                  <td>
                    <span class="pill pill-new">New</span>
                  </td>

                  <td>Oct 4, 2026</td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="btn btn-outline btn-sm"
                      >
                        View
                      </button>
                    </div>
                  </td>
                </tr>

                <tr
                  class="application-row"
                  data-candidate="sneha-kapoor"
                  data-job="backend-engineer"
                  data-status="Offer"
                  data-score="high"
                >
                  <td>
                    <div class="candidate-cell">
                      <div class="candidate-avatar">SK</div>

                      <div>
                        <span class="candidate-name">Sneha Kapoor</span>
                        <span class="candidate-sub">
                          sneha.kapoor@example.com
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>Backend Engineer</td>

                  <td>
                    <span class="score-high">86%</span>
                  </td>

                  <td>
                    <span class="pill pill-offer">Offer</span>
                  </td>

                  <td>Oct 1, 2026</td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="btn btn-outline btn-sm"
                      >
                        View
                      </button>
                    </div>
                  </td>
                </tr>

                <tr
                  class="application-row"
                  data-candidate="vikram-singh"
                  data-job="ai-engineer"
                  data-status="Rejected"
                  data-score="medium"
                >
                  <td>
                    <div class="candidate-cell">
                      <div class="candidate-avatar">VS</div>

                      <div>
                        <span class="candidate-name">Vikram Singh</span>
                        <span class="candidate-sub">
                          vikram.singh@example.com
                        </span>
                      </div>
                    </div>
                  </td>

                  <td>AI Engineer</td>

                  <td>
                    <span class="score-medium">74%</span>
                  </td>

                  <td>
                    <span class="pill pill-rejected">Rejected</span>
                  </td>

                  <td>Oct 4, 2026</td>

                  <td>
                    <div class="row-actions">
                      <button
                        type="button"
                        class="btn btn-outline btn-sm"
                      >
                        View
                      </button>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div id="emptyState" class="empty-state">
            No applications match the selected filters.
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    const applicationRows = document.querySelectorAll(".application-row");
    const emptyState = document.getElementById("emptyState");

    const searchInput = document.getElementById("applicationSearch");
    const jobFilter = document.getElementById("jobFilter");
    const statusFilter = document.getElementById("statusFilter");
    const scoreFilter = document.getElementById("scoreFilter");
    const resetFilters = document.getElementById("resetFilters");

    function applyFilters() {
      const searchTerm = searchInput.value.toLowerCase().trim();
      const selectedJob = jobFilter.value;
      const selectedStatus = statusFilter.value;
      const selectedScore = scoreFilter.value;

      let visibleCount = 0;

      applicationRows.forEach((row) => {
        const matchesSearch = row.textContent
          .toLowerCase()
          .includes(searchTerm);

        const matchesJob =
          !selectedJob || row.dataset.job === selectedJob;

        const matchesStatus =
          !selectedStatus || row.dataset.status === selectedStatus;

        const matchesScore =
          !selectedScore || row.dataset.score === selectedScore;

        const shouldShow =
          matchesSearch && matchesJob && matchesStatus && matchesScore;

        row.style.display = shouldShow ? "" : "none";

        if (shouldShow) {
          visibleCount += 1;
        }
      });

      emptyState.style.display = visibleCount === 0 ? "block" : "none";
    }

    applicationRows.forEach((row) => {
      const openCandidate = () => {
        const candidateId = row.dataset.candidate;

        window.location.href =
          "candidate-detail.html?id=" +
          encodeURIComponent(candidateId);
      };

      row.addEventListener("click", openCandidate);

      row.querySelector("button").addEventListener("click", (event) => {
        event.stopPropagation();
        openCandidate();
      });
    });

    searchInput.addEventListener("input", applyFilters);
    jobFilter.addEventListener("change", applyFilters);
    statusFilter.addEventListener("change", applyFilters);
    scoreFilter.addEventListener("change", applyFilters);

    resetFilters.addEventListener("click", () => {
      searchInput.value = "";
      jobFilter.value = "";
      statusFilter.value = "";
      scoreFilter.value = "";

      applyFilters();
    });

    document
      .getElementById("exportButton")
      .addEventListener("click", () => {
        alert("Application list export started in demo mode.");
      });

    document
      .getElementById("notificationButton")
      .addEventListener("click", () => {
        alert("You have 3 new notifications.");
      });
  </script>
</body>
</html>