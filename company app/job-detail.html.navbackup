<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Details — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --navy: #070d3f;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --vivid-blue: #1c19b8;
      --white: #ffffff;
      --light-blue: #e0e4f5;
      --ink: var(--deep-navy);
      --muted: #5b6b85;
      --line: var(--light-blue);
      --bg: #f7f9ff;
      --surface: var(--white);
      --green: #059669;
      --orange: #d97706;
      --red: #dc2626;
      --radius: 22px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 600px at 50% -20%, rgba(44, 131, 248, 0.08), transparent 70%),
        var(--bg);
      line-height: 1.65;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 20px 16px;
      overflow-y: auto;
      background: var(--white);
      border-right: 1px solid var(--line);
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      margin-bottom: 18px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
      color: var(--deep-navy);
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.30);
    }

    .nav-list {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      color: var(--muted);
      font-size: 14px;
      font-weight: 500;
      transition: 0.2s ease;
    }

    .nav-item:hover {
      color: var(--electric-blue);
      background: rgba(44, 131, 248, 0.06);
    }

    .nav-item.active {
      color: var(--royal-blue);
      font-weight: 600;
      background: linear-gradient(
        135deg,
        rgba(44, 131, 248, 0.12),
        rgba(39, 76, 220, 0.12)
      );
    }

    .nav-icon {
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

    .nav-section {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .nav-section-title {
      padding: 6px 12px;
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.7px;
      text-transform: uppercase;
    }

    /* Main */
    .main-content {
      min-width: 0;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      padding: 14px 0;
      backdrop-filter: blur(18px);
      background: rgba(247, 249, 255, 0.86);
      border-bottom: 1px solid var(--line);
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .back-btn,
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
      transition: 0.25s ease;
    }

    .back-btn {
      padding: 9px 14px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      font-size: 13px;
    }

    .back-btn:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
      transform: translateX(-2px);
    }

    .page-title {
      font-family: "Sora", sans-serif;
      font-size: 20px;
      color: var(--deep-navy);
    }

    .search-wrap {
      position: relative;
      flex: 1;
      max-width: 420px;
    }

    .search-input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 999px;
      outline: none;
    }

    .search-input:focus {
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .search-icon {
      position: absolute;
      top: 50%;
      left: 13px;
      color: var(--muted);
      transform: translateY(-50%);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn,
    .avatar-btn {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 50%;
    }

    .icon-btn {
      color: var(--muted);
      background: var(--white);
      border: 1px solid var(--line);
      cursor: pointer;
    }

    .avatar-btn {
      color: var(--white);
      font-size: 13px;
      font-weight: 700;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
    }

    /* Buttons */
    .btn {
      padding: 11px 18px;
      border: none;
      font-size: 13px;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.30);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 55px rgba(39, 76, 220, 0.35);
    }

    .btn-outline {
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
    }

    .btn-outline:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .btn-danger {
      color: var(--white);
      background: linear-gradient(135deg, #dc2626, #991b1b);
    }

    .btn-sm {
      padding: 7px 12px;
      font-size: 12px;
    }

    /* Page */
    .page-wrap {
      padding: 28px 0 60px;
    }

    .job-header,
    .panel {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .job-header {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 24px;
      margin-bottom: 18px;
    }

    .job-title {
      margin-bottom: 5px;
      font-family: "Sora", sans-serif;
      font-size: 26px;
      color: var(--deep-navy);
    }

    .job-meta {
      color: var(--muted);
      font-size: 13px;
    }

    .job-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .badge,
    .status-pill,
    .score-pill {
      display: inline-flex;
      align-items: center;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
    }

    .badge {
      color: var(--royal-blue);
      background: rgba(44, 131, 248, 0.08);
      border: 1px solid rgba(44, 131, 248, 0.22);
    }

    .status-active {
      color: var(--green);
      background: rgba(5, 150, 105, 0.10);
      border: 1px solid rgba(5, 150, 105, 0.25);
    }

    .job-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-content: flex-start;
      gap: 9px;
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 18px;
    }

    .panel {
      padding: 20px;
      margin-bottom: 18px;
    }

    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 15px;
    }

    .panel-title {
      font-family: "Sora", sans-serif;
      font-size: 18px;
      color: var(--deep-navy);
    }

    .panel-sub {
      color: var(--muted);
      font-size: 12px;
    }

    /* Metrics */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 18px;
    }

    .metric-card {
      padding: 15px;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 15px;
    }

    .metric-label {
      margin-bottom: 5px;
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .metric-value {
      color: var(--deep-navy);
      font-family: "Sora", sans-serif;
      font-size: 23px;
    }

    /* Description */
    .description {
      color: var(--muted);
      font-size: 14px;
    }

    .description h3 {
      margin: 18px 0 7px;
      color: var(--deep-navy);
      font-family: "Sora", sans-serif;
      font-size: 15px;
    }

    .description h3:first-child {
      margin-top: 0;
    }

    .description ul {
      padding-left: 20px;
    }

    /* AI box */
    .ai-box {
      display: flex;
      gap: 12px;
      padding: 15px;
      border: 1px solid rgba(44, 131, 248, 0.25);
      border-radius: 15px;
      background: rgba(44, 131, 248, 0.04);
    }

    .ai-icon {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      flex: 0 0 40px;
      border-radius: 12px;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
    }

    .ai-box strong {
      display: block;
      margin-bottom: 4px;
      color: var(--deep-navy);
      font-size: 13px;
    }

    .ai-box span {
      color: var(--muted);
      font-size: 12px;
    }

    /* Requirements */
    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag {
      padding: 6px 10px;
      color: var(--royal-blue);
      background: rgba(44, 131, 248, 0.07);
      border: 1px solid rgba(44, 131, 248, 0.20);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
    }

    /* Application table */
    .table-wrap {
      overflow-x: auto;
    }

    .table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .table th,
    .table td {
      padding: 11px 8px;
      text-align: left;
      border-bottom: 1px solid var(--line);
    }

    .table th {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .candidate {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 180px;
    }

    .candidate-avatar {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      font-size: 11px;
      font-weight: 700;
    }

    .candidate strong {
      display: block;
      color: var(--deep-navy);
      font-size: 13px;
    }

    .candidate span {
      color: var(--muted);
      font-size: 11px;
    }

    .score-high {
      color: var(--green);
      background: rgba(5, 150, 105, 0.10);
      border: 1px solid rgba(5, 150, 105, 0.25);
    }

    .score-medium {
      color: var(--electric-blue);
      background: rgba(44, 131, 248, 0.10);
      border: 1px solid rgba(44, 131, 248, 0.25);
    }

    .stage-new {
      color: var(--electric-blue);
      background: rgba(44, 131, 248, 0.10);
      border: 1px solid rgba(44, 131, 248, 0.25);
    }

    .stage-shortlisted {
      color: var(--royal-blue);
      background: rgba(39, 76, 220, 0.10);
      border: 1px solid rgba(39, 76, 220, 0.25);
    }

    /* Form */
    .form-group {
      margin-bottom: 15px;
    }

    .form-label {
      display: block;
      margin-bottom: 7px;
      color: var(--deep-navy);
      font-size: 13px;
      font-weight: 600;
    }

    .form-input,
    .form-textarea,
    .form-select {
      width: 100%;
      padding: 11px 13px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 12px;
      outline: none;
    }

    .form-textarea {
      min-height: 100px;
      resize: vertical;
    }

    .form-input:focus,
    .form-textarea:focus,
    .form-select:focus {
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    /* Animation */
    .reveal-up {
      opacity: 0;
      transform: translateY(16px);
      animation: revealUp 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.08s;
    }

    .delay-2 {
      animation-delay: 0.16s;
    }

    .delay-3 {
      animation-delay: 0.24s;
    }

    /* Responsive */
    @media (max-width: 1000px) {
      body {
        display: block;
      }

      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      .nav-list {
        grid-template-columns: repeat(2, 1fr);
      }

      .content-grid {
        grid-template-columns: 1fr;
      }

      .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 700px) {
      .nav-list {
        grid-template-columns: 1fr;
      }

      .topbar-inner {
        flex-wrap: wrap;
      }

      .search-wrap {
        order: 3;
        width: 100%;
        max-width: none;
      }

      .job-header {
        flex-direction: column;
      }

      .job-actions {
        justify-content: flex-start;
      }

      .metrics-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

