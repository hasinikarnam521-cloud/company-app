<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Subscription — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --navy: #070d3f;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --vivid-blue: #1c19b8;
      --white: #ffffff;
      --light-blue: #e0e4f5;

      --ink: var(--deep-navy);
      --muted: #5b6b85;
      --line: var(--light-blue);
      --bg: #f7f9ff;
      --surface: var(--white);

      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 600px at 50% -20%, rgba(44, 131, 248, 0.08), transparent 70%),
        var(--bg);
      line-height: 1.65;
      min-height: 100vh;
      overflow-x: hidden;
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      background: var(--white);
      border-right: 1px solid var(--line);
      padding: 20px 16px;
      overflow-y: auto;
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
      padding: 10px 12px;
      margin-bottom: 18px;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.30);
      font-size: 18px;
    }

    .nav-list {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      transition: 0.2s ease;
      cursor: pointer;
    }

    .nav-item:hover {
      background: rgba(44, 131, 248, 0.06);
      color: var(--electric-blue);
    }

    .nav-item.active {
      background: linear-gradient(135deg, rgba(44, 131, 248, 0.12), rgba(39, 76, 220, 0.12));
      color: var(--royal-blue);
      font-weight: 600;
    }

    .nav-icon {
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

    .nav-section {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .nav-section-title {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      padding: 6px 12px;
      margin-bottom: 6px;
    }

    /* Main content */
    .main-content {
      min-width: 0;
    }

    /* Top header */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(247, 249, 255, 0.85);
      border-bottom: 1px solid var(--line);
      padding: 14px 0;
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--deep-navy);
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: 0.2s ease;
      text-decoration: none;
    }

    .back-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateX(-2px);
    }

    .page-title {
      font-family: "Sora", sans-serif;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .search-wrap {
      flex: 1;
      max-width: 420px;
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-size: 14px;
      font-family: inherit;
      color: var(--deep-navy);
      background: var(--white);
      transition: 0.2s ease;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 15px;
      color: var(--muted);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--white);
      display: grid;
      place-items: center;
      font-size: 17px;
      color: var(--muted);
      cursor: pointer;
      transition: 0.2s;
    }

    .icon-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .avatar-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      color: var(--white);
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(44, 131, 248, 0.25);
    }

    /* Page content */
    .page-wrap {
      padding: 28px 0 60px;
    }

    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 18px;
    }

    .page-title-large {
      font-family: "Sora", sans-serif;
      font-size: 26px;
      letter-spacing: -1px;
      color: var(--deep-navy);
    }

    .page-sub {
      font-size: 13px;
      color: var(--muted);
    }

    .actions-right {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      border-radius: 999px;
      padding: 11px 18px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.25s ease;
      font-family: inherit;
      font-size: 13px;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.30);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 55px rgba(39, 76, 220, 0.35);
    }

    .btn-outline {
      background: var(--white);
      border: 1px solid var(--line);
      color: var(--deep-navy);
    }

    .btn-outline:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    /* Sections */
    .section-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 18px;
      margin-bottom: 18px;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .panel-title {
      font-family: "Sora", sans-serif;
      font-size: 18px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .panel-sub {
      font-size: 12px;
      color: var(--muted);
    }

    /* Current plan */
    .plan-summary {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 16px;
      align-items: center;
      margin-bottom: 16px;
    }

    .plan-name {
      font-family: "Sora", sans-serif;
      font-size: 22px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
      margin-bottom: 4px;
    }

    .plan-desc {
      font-size: 13px;
      color: var(--muted);
    }

    .plan-badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      background: rgba(44, 131, 248, 0.10);
      color: var(--electric-blue);
      border: 1px solid rgba(44, 131, 248, 0.25);
    }

    .usage-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 14px;
    }

    .usage-card {
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--white);
    }

    .usage-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 6px;
    }

    .usage-value {
      font-family: "Sora", sans-serif;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .usage-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
    }

    /* Payment & billing */
    .payment-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--white);
      margin-bottom: 14px;
    }

    .payment-info strong {
      display: block;
      font-size: 13px;
      color: var(--deep-navy);
      margin-bottom: 3px;
    }

    .payment-info span {
      font-size: 12px;
      color: var(--muted);
    }

    .billing-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .billing-table th,
    .billing-table td {
      text-align: left;
      padding: 10px 8px;
      border-bottom: 1px solid var(--line);
    }

    .billing-table th {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 600;
    }

    /* Animations */
    .reveal-up {
      opacity: 0;
      transform: translateY(16px);
      animation: revealUp 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.06s;
    }

    .delay-2 {
      animation-delay: 0.12s;
    }

    .delay-3 {
      animation-delay: 0.18s;
    }

    /* Responsive */
    @media (max-width: 1000px) {
      body {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: relative;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      .nav-list {
        grid-template-columns: repeat(2, 1fr);
      }

      .section-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .nav-list {
        grid-template-columns: 1fr;
      }

      .search-wrap {
        order: 3;
        max-width: 100%;
        margin: 10px 0 0;
        width: 100%;
      }

      .topbar-inner {
        flex-wrap: wrap;
      }

      .usage-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">V</div>
      <span>VENTRIXCARROS</span>
    </div>

    <nav class="nav-list">
      <div class="nav-item">
        <span class="nav-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<rect x="3" y="3" width="7" height="7" rx="1"></rect>
<rect x="14" y="3" width="7" height="7" rx="1"></rect>
<rect x="3" y="14" width="7" height="7" rx="1"></rect>
<rect x="14" y="14" width="7" height="7" rx="1"></rect>
</svg>
</span>
        Dashboard
      </div>
      <div class="nav-item">
        <span class="nav-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="8" r="3"></circle>
<path d="M5 21v-2a7 7 0 0 1 14 0v2"></path>
<path d="M19 5l1 1"></path>
<path d="M20 4l-1 1"></path>
</svg>
</span>
        AI Recruitment
      </div>
      <div class="nav-item">
        <span class="nav-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<rect x="3" y="7" width="18" height="13" rx="2"></rect>
