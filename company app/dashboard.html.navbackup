<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Company Dashboard — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --navy: #070d3f;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --vivid-blue: #1c19b8;
      --white: #ffffff;
      --light-blue: #e0e4f5;

      --ink: var(--deep-navy);
      --muted: #5b6b85;
      --line: var(--light-blue);
      --bg: #f7f9ff;
      --surface: var(--white);

      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 600px at 50% -20%, rgba(44, 131, 248, 0.08), transparent 70%),
        var(--bg);
      line-height: 1.65;
      min-height: 100vh;
      overflow-x: hidden;
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      background: var(--white);
      border-right: 1px solid var(--line);
      padding: 20px 16px;
      overflow-y: auto;
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
      padding: 10px 12px;
      margin-bottom: 18px;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.30);
      font-size: 18px;
    }

    .nav-list {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      transition: 0.2s ease;
      cursor: pointer;
    }

    .nav-item:hover {
      background: rgba(44, 131, 248, 0.06);
      color: var(--electric-blue);
    }

    .nav-item.active {
      background: linear-gradient(135deg, rgba(44, 131, 248, 0.12), rgba(39, 76, 220, 0.12));
      color: var(--royal-blue);
      font-weight: 600;
    }

  .nav-icon {
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-icon svg {
  width: 19px;
  height: 19px;
  display: block;
}

    .nav-section {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .nav-section-title {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      padding: 6px 12px;
      margin-bottom: 6px;
    }

    /* Main content */
    .main-content {
      min-width: 0;
    }

    /* Top header */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(247, 249, 255, 0.85);
      border-bottom: 1px solid var(--line);
      padding: 14px 0;
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--deep-navy);
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: 0.2s ease;
      text-decoration: none;
    }

    .back-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateX(-2px);
    }

    .page-title {
      font-family: "Sora", sans-serif;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .search-wrap {
      flex: 1;
      max-width: 420px;
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-size: 14px;
      font-family: inherit;
      color: var(--deep-navy);
      background: var(--white);
      transition: 0.2s ease;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 15px;
      color: var(--muted);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--white);
      display: grid;
      place-items: center;
      font-size: 17px;
      color: var(--muted);
      cursor: pointer;
      transition: 0.2s;
    }

    .icon-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .avatar-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      color: var(--white);
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(44, 131, 248, 0.25);
    }

    /* Dashboard content */
    .dashboard-wrap {
      padding: 28px 0 60px;
    }

    .dashboard-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 20px;
    }

    .dashboard-title {
      font-family: "Sora", sans-serif;
      font-size: 26px;
      letter-spacing: -1px;
      color: var(--deep-navy);
    }

    .dashboard-sub {
      font-size: 13px;
      color: var(--muted);
    }

    .quick-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      border-radius: 999px;
      padding: 11px 18px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.25s ease;
      font-family: inherit;
      font-size: 13px;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.30);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 55px rgba(39, 76, 220, 0.35);
    }

    .btn-outline {
      background: var(--white);
      border: 1px solid var(--line);
      color: var(--deep-navy);
    }

    .btn-outline:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    /* KPI grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }

    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .kpi-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 28px 80px rgba(5, 10, 48, 0.12);
    }

    .kpi-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      margin-bottom: 8px;
    }

    .kpi-value {
      font-family: "Sora", sans-serif;
      font-size: 28px;
      letter-spacing: -1px;
      color: var(--deep-navy);
      margin-bottom: 6px;
    }

    .kpi-delta {
      font-size: 11px;
      color: var(--muted);
    }

    .delta-up {
      color: #059669;
    }

    .delta-down {
      color: #dc2626;
    }

    /* Main grid: AI insights + candidates */
    .main-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 18px;
      margin-bottom: 20px;
    }

    .panel {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .panel-title {
      font-family: "Sora", sans-serif;
      font-size: 18px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .panel-sub {
      font-size: 12px;
      color: var(--muted);
    }

    .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(44, 131, 248, 0.08);
      border: 1px solid rgba(44, 131, 248, 0.25);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--royal-blue);
    }

    /* AI insights list */
    .insights-list {
      display: grid;
      gap: 12px;
    }

    .insight-card {
      display: flex;
      gap: 12px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--white);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .insight-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 45px rgba(5, 10, 48, 0.08);
    }

    .insight-icon {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      display: grid;
      place-items: center;
      font-size: 17px;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 8px 20px rgba(44, 131, 248, 0.25);
      flex: 0 0 38px;
    }

    .insight-text strong {
      display: block;
      font-size: 13px;
      color: var(--deep-navy);
      margin-bottom: 4px;
    }

    .insight-text span {
      font-size: 12px;
      color: var(--muted);
    }

    /* Candidates table */
    .table-wrap {
      overflow-x: auto;
    }

    .table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .table th,
    .table td {
      text-align: left;
      padding: 10px 8px;
      border-bottom: 1px solid var(--line);
    }

    .table th {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 600;
    }

    .candidate-name {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .candidate-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      color: var(--white);
      display: grid;
      place-items: center;
      font-size: 11px;
      font-weight: 700;
    }

    .score-pill {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      font-family: "Sora", sans-serif;
    }

    .score-high {
      background: rgba(5, 150, 105, 0.10);
      color: #059669;
      border: 1px solid rgba(5, 150, 105, 0.25);
    }

    .score-medium {
      background: rgba(44, 131, 248, 0.10);
      color: var(--electric-blue);
      border: 1px solid rgba(44, 131, 248, 0.25);
    }

    .score-low {
      background: rgba(220, 38, 38, 0.10);
      color: #dc2626;
      border: 1px solid rgba(220, 38, 38, 0.25);
    }

    .status-pill {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
    }

    .status-new {
      background: rgba(44, 131, 248, 0.10);
      color: var(--electric-blue);
      border: 1px solid rgba(44, 131, 248, 0.25);
    }

    .status-screened {
      background: rgba(5, 150, 105, 0.10);
      color: #059669;
      border: 1px solid rgba(5, 150, 105, 0.25);
    }

    .status-interview {
      background: rgba(245, 158, 11, 0.10);
      color: #d97706;
      border: 1px solid rgba(245, 158, 11, 0.25);
    }

    /* Animations */
    .reveal-up {
      opacity: 0;
      transform: translateY(16px);
      animation: revealUp 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.06s;
    }

    .delay-2 {
      animation-delay: 0.12s;
    }

    .delay-3 {
      animation-delay: 0.18s;
    }

    .delay-4 {
      animation-delay: 0.24s;
    }

    /* Responsive */
    @media (max-width: 1000px) {
      body {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: relative;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      .nav-list {
        grid-template-columns: repeat(2, 1fr);
      }

      .kpi-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .main-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .nav-list {
        grid-template-columns: 1fr;
      }

      .kpi-grid {
        grid-template-columns: 1fr;
      }

      .quick-actions {
        width: 100%;
      }

      .btn {
        flex: 1;
      }

      .search-wrap {
        order: 3;
        max-width: 100%;
        margin: 10px 0 0;
        width: 100%;
      }

      .topbar-inner {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">V</div>
      <span>VENTRIXCARROS</span>
