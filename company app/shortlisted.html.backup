<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shortlisted Candidates — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --white: #ffffff;
      --light-blue: #e0e4f5;
      --muted: #5b6b85;
      --bg: #f7f9ff;
      --green: #059669;
      --orange: #d97706;
      --red: #dc2626;
      --line: var(--light-blue);
      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--deep-navy);
      font-family: "Inter", sans-serif;
      line-height: 1.65;
      background:
        radial-gradient(
          900px 600px at 50% -20%,
          rgba(44, 131, 248, 0.08),
          transparent 70%
        ),
        var(--bg);
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 20px 16px;
      overflow-y: auto;
      background: var(--white);
      border-right: 1px solid var(--line);
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      margin-bottom: 18px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.3);
    }

    .nav-list {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      color: var(--muted);
      font-size: 14px;
      font-weight: 500;
      transition: 0.2s ease;
    }

    .nav-item:hover {
      color: var(--electric-blue);
      background: rgba(44, 131, 248, 0.06);
    }

    .nav-item.active {
      color: var(--royal-blue);
      font-weight: 600;
      background: linear-gradient(
        135deg,
        rgba(44, 131, 248, 0.12),
        rgba(39, 76, 220, 0.12)
      );
    }

    .nav-icon {
      width: 22px;
      text-align: center;
    }

    .nav-section {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .nav-section-title {
      padding: 6px 12px;
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.7px;
      text-transform: uppercase;
    }

    /* Topbar */
    .main-content {
      min-width: 0;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      padding: 14px 0;
      backdrop-filter: blur(18px);
      background: rgba(247, 249, 255, 0.86);
      border-bottom: 1px solid var(--line);
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .back-btn,
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
      transition: 0.25s ease;
    }

    .back-btn {
      padding: 9px 14px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      font-size: 13px;
    }

    .back-btn:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
      transform: translateX(-2px);
    }

    .page-title {
      font-family: "Sora", sans-serif;
      font-size: 20px;
    }

    .search-wrap {
      position: relative;
      flex: 1;
      max-width: 420px;
    }

    .search-input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 999px;
      outline: none;
      font-size: 14px;
    }

    .search-input:focus {
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .search-icon {
      position: absolute;
      top: 50%;
      left: 13px;
      color: var(--muted);
      transform: translateY(-50%);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn,
    .avatar-btn {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 50%;
    }

    .icon-btn {
      color: var(--muted);
      background: var(--white);
      border: 1px solid var(--line);
      cursor: pointer;
      font-size: 17px;
    }

    .icon-btn:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
    }

    .avatar-btn {
      color: var(--white);
      font-size: 13px;
      font-weight: 700;
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
    }

    /* Buttons */
    .btn {
      padding: 11px 18px;
      border: none;
      font-size: 13px;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
    }

    .btn-outline {
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
    }

    .btn-outline:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .btn-sm {
      padding: 7px 12px;
      font-size: 12px;
    }

    /* Page */
    .page-wrap {
      padding: 28px 0 60px;
    }

    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .page-heading {
      margin-bottom: 3px;
      font-family: "Sora", sans-serif;
      font-size: 27px;
      letter-spacing: -1px;
    }

    .page-sub {
      color: var(--muted);
      font-size: 13px;
    }

    .head-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Filters */
    .filters {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding: 16px;
      margin-bottom: 18px;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .filter-select {
      padding: 10px 14px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 999px;
      outline: none;
      font-size: 13px;
      font-weight: 600;
    }

    .filter-select:focus {
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .filter-reset {
      margin-left: auto;
    }

    /* Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 18px;
    }

    .stat-card,
    .panel {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .stat-card {
      padding: 18px;
      transition: 0.25s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
    }

    .stat-label {
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.7px;
      text-transform: uppercase;
    }

    .stat-value {
      font-family: "Sora", sans-serif;
      font-size: 27px;
    }

    .stat-note {
      color: var(--muted);
      font-size: 11px;
    }

    .note-up {
      color: var(--green);
    }

    .note-warning {
      color: var(--orange);
    }

    /* Candidate cards */
    .candidate-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .candidate-card {
      position: relative;
      padding: 20px;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      cursor: pointer;
      transition: 0.25s ease;
    }

    .candidate-card:hover {
      transform: translateY(-5px);
      border-color: var(--electric-blue);
      box-shadow: 0 28px 80px rgba(44, 131, 248, 0.18);
    }

    .candidate-top {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .candidate-avatar {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      flex: 0 0 54px;
      border-radius: 18px;
      color: var(--white);
      font-family: "Sora", sans-serif;
      font-weight: 800;
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.28);
    }

    .candidate-name {
      margin-bottom: 2px;
      font-family: "Sora", sans-serif;
      font-size: 16px;
    }

    .candidate-role {
      color: var(--muted);
      font-size: 12px;
    }

    .star-badge {
      position: absolute;
      top: 16px;
      right: 16px;
      padding: 4px 9px;
      color: var(--orange);
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.25);
      border-radius: 999px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .candidate-meta {
      display: grid;
      gap: 7px;
      margin-bottom: 14px;
      padding: 12px;
      background: rgba(44, 131, 248, 0.04);
      border: 1px solid rgba(44, 131, 248, 0.14);
      border-radius: 14px;
    }

    .meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      color: var(--muted);
      font-size: 12px;
    }

    .meta-row strong {
      color: var(--deep-navy);
      font-size: 12px;
    }

    .score-high {
      color: var(--green);
      font-weight: 700;
    }

    .score-medium {
      color: var(--orange);
      font-weight: 700;
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 16px;
    }

    .skill-tag {
      padding: 5px 9px;
      color: var(--royal-blue);
      background: rgba(44, 131, 248, 0.07);
      border: 1px solid rgba(44, 131, 248, 0.2);
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
    }

    .card-actions {
      display: flex;
      gap: 8px;
    }

    .card-actions .btn {
      flex: 1;
    }

    .empty-state {
      display: none;
      padding: 40px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }

    /* Animation */
    .reveal-up {
      opacity: 0;
      transform: translateY(16px);
      animation: revealUp 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.06s;
    }

    .delay-2 {
      animation-delay: 0.12s;
    }

    .delay-3 {
      animation-delay: 0.18s;
    }

    @media (max-width: 1000px) {
      body {
        display: block;
      }

      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      .nav-list {
        grid-template-columns: repeat(2, 1fr);
      }

      .stats-grid,
      .candidate-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 700px) {
      .nav-list {
        grid-template-columns: 1fr;
      }

      .topbar-inner {
        flex-wrap: wrap;
      }

      .search-wrap {
        order: 3;
        width: 100%;
        max-width: none;
      }

      .stats-grid,
      .candidate-grid {
        grid-template-columns: 1fr;
      }

      .filter-reset {
        margin-left: 0;
      }
    }
  </style>
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">V</div>
      <span>VENTRIXCARROS</span>
    </div>

    <nav class="nav-list">
      <a href="dashboard.html" class="nav-item">
        <span class="nav-icon">🏠</span>
        Dashboard
      </a>

      <a href="ai-recruitment.html" class="nav-item">
        <span class="nav-icon">🤖</span>
        AI Recruitment
      </a>

      <a href="jobs.html" class="nav-item">
        <span class="nav-icon">💼</span>
        Jobs
      </a>

      <a href="candidates.html" class="nav-item">
        <span class="nav-icon">👥</span>
        Candidates
      </a>

      <a href="applications.html" class="nav-item">
        <span class="nav-icon">📋</span>
        Applications
      </a>

      <a href="shortlisted.html" class="nav-item active">
        <span class="nav-icon">⭐</span>
        Shortlisted
      </a>

      <a href="interviews.html" class="nav-item">
        <span class="nav-icon">🎤</span>
        Interviews
      </a>

      <a href="messages.html" class="nav-item">
        <span class="nav-icon">💬</span>
        Messages
      </a>

      <a href="analytics.html" class="nav-item">
        <span class="nav-icon">📊</span>
        Analytics
      </a>

      <div class="nav-section">
        <div class="nav-section-title">Account</div>

        <a href="subscription.html" class="nav-item">
          <span class="nav-icon">💳</span>
          Subscription
        </a>

        <a href="company-profile.html" class="nav-item">
          <span class="nav-icon">🏢</span>
          Company Profile
        </a>

        <a href="settings.html" class="nav-item">
          <span class="nav-icon">⚙️</span>
          Settings
        </a>

        <a href="index.html" class="nav-item">
          <span class="nav-icon">🚪</span>
          Logout
        </a>
      </div>
    </nav>
  </aside>

  <div class="main-content">
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <a href="dashboard.html" class="back-btn">← Back</a>
          <div class="page-title">Shortlisted Candidates</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            id="shortlistSearch"
            class="search-input"
            type="search"
            placeholder="Search shortlisted candidates..."
          />
        </div>

        <div class="nav-right">
          <button id="notificationButton" class="icon-btn">🔔</button>
          <div class="avatar-btn">VC</div>
        </div>
      </div>
    </header>

    <main class="page-wrap">
      <div class="container">
        <section class="page-head reveal-up">
          <div>
            <h1 class="page-heading">Shortlisted candidates</h1>
            <p class="page-sub">
              Candidates marked as strong fits and ready for the next hiring stage.
            </p>
          </div>

          <div class="head-actions">
            <a href="interviews.html" class="btn btn-primary">
              🎤 Schedule interviews
            </a>

            <button id="exportButton" class="btn btn-outline">
              ⬇ Export list
            </button>
          </div>
        </section>

        <section class="stats-grid">
          <div class="stat-card reveal-up delay-1">
            <div class="stat-label">Total shortlisted</div>
            <div class="stat-value">47</div>
            <div class="stat-note note-up">↑ 9 this week</div>
          </div>

          <div class="stat-card reveal-up delay-2">
            <div class="stat-label">High AI match</div>
            <div class="stat-value">31</div>
            <div class="stat-note">85% or above</div>
          </div>

          <div class="stat-card reveal-up delay-3">
            <div class="stat-label">Interview scheduled</div>
            <div class="stat-value">18</div>
            <div class="stat-note note-warning">5 scheduled today</div>
          </div>

          <div class="stat-card reveal-up delay-3">
            <div class="stat-label">Offers sent</div>
            <div class="stat-value">4</div>
            <div class="stat-note note-up">1 accepted</div>
          </div>
        </section>

        <section class="filters reveal-up delay-2">
          <select id="jobFilter" class="filter-select">
            <option value="">All jobs</option>
            <option value="frontend-developer">Frontend Developer</option>
            <option value="ai-engineer">AI Engineer</option>
            <option value="backend-engineer">Backend Engineer</option>
          </select>

          <select id="scoreFilter" class="filter-select">
            <option value="">All AI scores</option>
            <option value="high">High match (85%+)</option>
            <option value="medium">Medium match (70–84%)</option>
          </select>

          <select id="interviewFilter" class="filter-select">
            <option value="">All interview status</option>
            <option value="scheduled">Interview scheduled</option>
            <option value="pending">Interview pending</option>
          </select>

          <button id="resetFilters" class="btn btn-outline btn-sm filter-reset">
            Reset filters
          </button>
        </section>

        <section id="candidateGrid" class="candidate-grid">
          <!-- Rahul Sharma -->
          <article
            class="candidate-card reveal-up delay-2"
            data-candidate="rahul-sharma"
            data-job="frontend-developer"
            data-score="high"
            data-interview="scheduled"
          >
            <span class="star-badge">★ Shortlisted</span>

            <div class="candidate-top">
              <div class="candidate-avatar">RS</div>

              <div>
                <h3 class="candidate-name">Rahul Sharma</h3>
                <p class="candidate-role">
                  Frontend Developer · 3 years
                </p>
              </div>
            </div>

            <div class="candidate-meta">
              <div class="meta-row">
                <span>AI match</span>
                <strong class="score-high">92%</strong>
              </div>

              <div class="meta-row">
                <span>Location</span>
                <strong>Remote</strong>
              </div>

              <div class="meta-row">
                <span>Interview</span>
                <strong>Scheduled · Oct 10</strong>
              </div>
            </div>

            <div class="skills">
              <span class="skill-tag">React</span>
              <span class="skill-tag">TypeScript</span>
              <span class="skill-tag">Next.js</span>
            </div>

            <div class="card-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm view-button"
              >
                View profile
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm interview-button"
              >
                Interview
              </button>
            </div>
          </article>

          <!-- Priya Nair -->
          <article
            class="candidate-card reveal-up delay-2"
            data-candidate="priya-nair"
            data-job="ai-engineer"
            data-score="high"
            data-interview="scheduled"
          >
            <span class="star-badge">★ Shortlisted</span>

            <div class="candidate-top">
              <div class="candidate-avatar">PN</div>

              <div>
                <h3 class="candidate-name">Priya Nair</h3>
                <p class="candidate-role">
                  AI Engineer · 5 years
                </p>
              </div>
            </div>

            <div class="candidate-meta">
              <div class="meta-row">
                <span>AI match</span>
                <strong class="score-high">89%</strong>
              </div>

              <div class="meta-row">
                <span>Location</span>
                <strong>Bengaluru</strong>
              </div>

              <div class="meta-row">
                <span>Interview</span>
                <strong>Scheduled · Oct 11</strong>
              </div>
            </div>

            <div class="skills">
              <span class="skill-tag">Python</span>
              <span class="skill-tag">LLMs</span>
              <span class="skill-tag">PyTorch</span>
            </div>

            <div class="card-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm view-button"
              >
                View profile
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm interview-button"
              >
                Interview
              </button>
            </div>
          </article>

          <!-- Sneha Kapoor -->
          <article
            class="candidate-card reveal-up delay-3"
            data-candidate="sneha-kapoor"
            data-job="backend-engineer"
            data-score="high"
            data-interview="pending"
          >
            <span class="star-badge">★ Shortlisted</span>

            <div class="candidate-top">
              <div class="candidate-avatar">SK</div>

              <div>
                <h3 class="candidate-name">Sneha Kapoor</h3>
                <p class="candidate-role">
                  Backend Engineer · 4 years
                </p>
              </div>
            </div>

            <div class="candidate-meta">
              <div class="meta-row">
                <span>AI match</span>
                <strong class="score-high">86%</strong>
              </div>

              <div class="meta-row">
                <span>Location</span>
                <strong>Mumbai</strong>
              </div>

              <div class="meta-row">
                <span>Interview</span>
                <strong>Pending</strong>
              </div>
            </div>

            <div class="skills">
              <span class="skill-tag">Node.js</span>
              <span class="skill-tag">PostgreSQL</span>
              <span class="skill-tag">AWS</span>
            </div>

            <div class="card-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm view-button"
              >
                View profile
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm interview-button"
              >
                Interview
              </button>
            </div>
          </article>

          <!-- Arjun Mehta -->
          <article
            class="candidate-card reveal-up delay-3"
            data-candidate="arjun-mehta"
            data-job="frontend-developer"
            data-score="medium"
            data-interview="pending"
          >
            <span class="star-badge">★ Shortlisted</span>

            <div class="candidate-top">
              <div class="candidate-avatar">AM</div>

              <div>
                <h3 class="candidate-name">Arjun Mehta</h3>
                <p class="candidate-role">
                  Frontend Developer · 2 years
                </p>
              </div>
            </div>

            <div class="candidate-meta">
              <div class="meta-row">
                <span>AI match</span>
                <strong class="score-medium">78%</strong>
              </div>

              <div class="meta-row">
                <span>Location</span>
                <strong>Delhi NCR</strong>
              </div>

              <div class="meta-row">
                <span>Interview</span>
                <strong>Pending</strong>
              </div>
            </div>

            <div class="skills">
              <span class="skill-tag">React</span>
              <span class="skill-tag">JavaScript</span>
              <span class="skill-tag">REST APIs</span>
            </div>

            <div class="card-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm view-button"
              >
                View profile
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm interview-button"
              >
                Interview
              </button>
            </div>
          </article>
        </section>

        <div id="emptyState" class="empty-state">
          No shortlisted candidates match the selected filters.
        </div>
      </div>
    </main>
  </div>

  <script>
    const candidateCards = document.querySelectorAll(".candidate-card");
    const emptyState = document.getElementById("emptyState");

    const searchInput = document.getElementById("shortlistSearch");
    const jobFilter = document.getElementById("jobFilter");
    const scoreFilter = document.getElementById("scoreFilter");
    const interviewFilter = document.getElementById("interviewFilter");
    const resetFilters = document.getElementById("resetFilters");

    function applyFilters() {
      const searchTerm = searchInput.value.toLowerCase().trim();
      const selectedJob = jobFilter.value;
      const selectedScore = scoreFilter.value;
      const selectedInterview = interviewFilter.value;

      let visibleCount = 0;

      candidateCards.forEach((card) => {
        const matchesSearch = card.textContent
          .toLowerCase()
          .includes(searchTerm);

        const matchesJob =
          !selectedJob || card.dataset.job === selectedJob;

        const matchesScore =
          !selectedScore || card.dataset.score === selectedScore;

        const matchesInterview =
          !selectedInterview ||
          card.dataset.interview === selectedInterview;

        const shouldShow =
          matchesSearch &&
          matchesJob &&
          matchesScore &&
          matchesInterview;

        card.style.display = shouldShow ? "" : "none";

        if (shouldShow) {
          visibleCount += 1;
        }
      });

      emptyState.style.display = visibleCount === 0 ? "block" : "none";
    }

    function openCandidate(candidateId) {
      window.location.href =
        "candidate-detail.html?id=" +
        encodeURIComponent(candidateId);
    }

    candidateCards.forEach((card) => {
      const candidateId = card.dataset.candidate;

      card.addEventListener("click", () => {
        openCandidate(candidateId);
      });

      card
        .querySelector(".view-button")
        .addEventListener("click", (event) => {
          event.stopPropagation();
          openCandidate(candidateId);
        });

      card
        .querySelector(".interview-button")
        .addEventListener("click", (event) => {
          event.stopPropagation();
          window.location.href = "interviews.html";
        });
    });

    searchInput.addEventListener("input", applyFilters);
    jobFilter.addEventListener("change", applyFilters);
    scoreFilter.addEventListener("change", applyFilters);
    interviewFilter.addEventListener("change", applyFilters);

    resetFilters.addEventListener("click", () => {
      searchInput.value = "";
      jobFilter.value = "";
      scoreFilter.value = "";
      interviewFilter.value = "";

      applyFilters();
    });

    document
      .getElementById("exportButton")
      .addEventListener("click", () => {
        alert("Shortlist export started in demo mode.");
      });

    document
      .getElementById("notificationButton")
      .addEventListener("click", () => {
        alert("You have 3 new notifications.");
      });
  </script>
</body>
</html>