  </svg>
</span>
          Company Profile
        </a>
        <a href="settings.html" class="nav-item">
          <span class="nav-icon">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="3"></circle>
    <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20h-2.6v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2.6h.4A1.7 1.7 0 0 0 8 10a1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V5H15v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.4V14h-.4a1.7 1.7 0 0 0-1.6 1z"></path>
  </svg>
</span>
          Settings
        </a>
        <a href="index.html" class="nav-item">
          <span class="nav-icon">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"></path>
    <path d="M14 8l4 4-4 4"></path>
    <path d="M9 12h9"></path>
  </svg>
</span>
          Logout
        </a>
      </div>
    </nav>
  </aside>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <!-- Back button goes to home/landing page -->
          <a href="index.html" class="back-btn">
            ← Back
          </a>
          <div class="page-title">Company Dashboard</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            class="search-input"
            type="text"
            placeholder="Search jobs, candidates, or companies..."
          />
        </div>

        <div class="nav-right">
          <button class="icon-btn" title="Notifications">🔔</button>
          <div class="avatar-btn" title="Profile">VC</div>
        </div>
      </div>
    </header>

    <!-- Dashboard content -->
    <main class="dashboard-wrap">
      <div class="container">
        <!-- Head + quick actions -->
        <div class="dashboard-head reveal-up">
          <div>
            <h1 class="dashboard-title">Overview</h1>
            <p class="dashboard-sub">
              Manage jobs, candidates, and AI-powered hiring workflows
            </p>
          </div>

          <div class="quick-actions">
            <a href="jobs.html" class="btn btn-primary">➕ Post a job</a>
            <a href="candidates.html" class="btn btn-outline">👥 View candidates</a>
            <a href="analytics.html" class="btn btn-outline">📊 Analytics</a>
          </div>
        </div>

        <!-- KPI cards -->
        <div class="kpi-grid">
          <div class="kpi-card reveal-up delay-1">
            <div class="kpi-label">Active jobs</div>
            <div class="kpi-value">12</div>
            <div class="kpi-delta delta-up">↑ 3 this week</div>
          </div>

          <div class="kpi-card reveal-up delay-2">
            <div class="kpi-label">Applications</div>
            <div class="kpi-value">184</div>
            <div class="kpi-delta delta-up">↑ 28 vs last week</div>
          </div>

          <div class="kpi-card reveal-up delay-3">
            <div class="kpi-label">Shortlisted</div>
            <div class="kpi-value">47</div>
            <div class="kpi-delta delta-up">↑ 9 via AI</div>
          </div>

          <div class="kpi-card reveal-up delay-4">
            <div class="kpi-label">Interviews</div>
            <div class="kpi-value">18</div>
            <div class="kpi-delta delta-down">↓ 2 cancellations</div>
          </div>
        </div>

        <!-- Main grid: AI insights + candidates -->
        <div class="main-grid">
          <!-- AI Insights panel -->
          <section class="panel reveal-up delay-3">
            <div class="panel-head">
              <div>
                <h2 class="panel-title">AI Insights</h2>
                <p class="panel-sub">
                  Smart suggestions to improve your hiring process
                </p>
              </div>
              <span class="ai-badge">● AI Active</span>
            </div>

            <div class="insights-list">
              <div class="insight-card">
                <div class="insight-icon">🎯</div>
                <div class="insight-text">
                  <strong>Top 5 candidates for “Frontend Developer”</strong>
                  <span>
                    AI identified 5 strong matches with 85%+ fit based on skills
                    and experience.
                  </span>
                </div>
              </div>

              <div class="insight-card">
                <div class="insight-icon">⏱</div>
                <div class="insight-text">
                  <strong>Reduce time-to-hire by 22%</strong>
                  <span>
                    Automate initial screening for high-volume roles to cut manual
                    review time.
                  </span>
                </div>
              </div>

              <div class="insight-card">
                <div class="insight-icon">🧭</div>
                <div class="insight-text">
                  <strong>Job description optimization</strong>
                  <span>
                    Rewrite requirements for “AI Engineer” to attract more
                    mid–senior candidates.
                  </span>
                </div>
              </div>
            </div>
          </section>

          <!-- Recent candidates -->
          <section class="panel reveal-up delay-4">
            <div class="panel-head">
              <div>
                <h2 class="panel-title">Recent candidates</h2>
                <p class="panel-sub">
                  Latest applications with AI match scores
                </p>
              </div>
              <a href="candidates.html" class="btn btn-outline" style="padding: 7px 12px; font-size: 12px;">
                View all
              </a>
            </div>

            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th>Candidate</th>
                    <th>Role</th>
                    <th>AI score</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>
                      <div class="candidate-name">
                        <div class="candidate-avatar">RS</div>
                        <div>
                          <div style="font-weight: 600">Rahul Sharma</div>
                          <div style="font-size: 11px; color: var(--muted)">
                            3 yrs • Frontend
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>Frontend Developer</td>
                    <td><span class="score-pill score-high">92%</span></td>
                    <td><span class="status-pill status-screened">Screened</span></td>
                  </tr>

                  <tr>
                    <td>
                      <div class="candidate-name">
                        <div class="candidate-avatar">PN</div>
                        <div>
                          <div style="font-weight: 600">Priya Nair</div>
                          <div style="font-size: 11px; color: var(--muted)">
                            5 yrs • AI/ML
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>AI Engineer</td>
                    <td><span class="score-pill score-high">89%</span></td>
                    <td><span class="status-pill status-interview">Interview</span></td>
                  </tr>

                  <tr>
                    <td>
                      <div class="candidate-name">
                        <div class="candidate-avatar">AM</div>
                        <div>
                          <div style="font-weight: 600">Arjun Mehta</div>
                          <div style="font-size: 11px; color: var(--muted)">
                            2 yrs • Frontend
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>Frontend Developer</td>
                    <td><span class="score-pill score-medium">78%</span></td>
                    <td><span class="status-pill status-new">New</span></td>
                  </tr>

                  <tr>
                    <td>
                      <div class="candidate-name">
                        <div class="candidate-avatar">SK</div>
                        <div>
                          <div style="font-weight: 600">Sneha Kapoor</div>
                          <div style="font-size: 11px; color: var(--muted)">
                            4 yrs • Backend
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>Backend Engineer</td>
                    <td><span class="score-pill score-medium">74%</span></td>
                    <td><span class="status-pill status-new">New</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>

  <script>
    // Highlight active nav item based on current page
    const currentPage = window.location.pathname.split('/').pop() || 'dashboard.html';
    document.querySelectorAll('.nav-item').forEach(item => {
      const href = item.getAttribute('href') || '';
      if (href === currentPage) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }

      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
      });
    });

    // Optional: wire quick action buttons
    document.querySelector('.btn-primary')?.addEventListener('click', () => {
      console.log('Post a job clicked');
    });
  </script>
</body>
</html>