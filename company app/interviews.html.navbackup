  </aside>

  <div class="main-content">
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <a href="dashboard.html" class="back-btn">← Back</a>
          <div class="page-title">Interviews</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            id="interviewSearch"
            class="search-input"
            type="search"
            placeholder="Search interviews by candidate or role..."
          />
        </div>

        <div class="nav-right">
          <button id="notificationButton" class="icon-btn">🔔</button>
          <div class="avatar-btn">VC</div>
        </div>
      </div>
    </header>

    <main class="page-wrap">
      <div class="container">
        <section class="page-head reveal-up">
          <div>
            <h1 class="page-heading">Interview management</h1>
            <p class="page-sub">
              Schedule, track, and manage candidate interviews.
            </p>
          </div>

          <div class="head-actions">
            <button id="scheduleFocusButton" class="btn btn-primary">
              ➕ Schedule interview
            </button>

            <button id="exportButton" class="btn btn-outline">
              ⬇ Export schedule
            </button>
          </div>
        </section>

        <section class="stats-grid">
          <div class="stat-card reveal-up delay-1">
            <div class="stat-label">Total interviews</div>
            <div class="stat-value">18</div>
            <div class="stat-note note-up">↑ 4 this week</div>
          </div>

          <div class="stat-card reveal-up delay-2">
            <div class="stat-label">Scheduled today</div>
            <div class="stat-value">5</div>
            <div class="stat-note note-warning">2 starting soon</div>
          </div>

          <div class="stat-card reveal-up delay-3">
            <div class="stat-label">Completed</div>
            <div class="stat-value">11</div>
            <div class="stat-note">Feedback pending for 3</div>
          </div>

          <div class="stat-card reveal-up delay-3">
            <div class="stat-label">Offers sent</div>
            <div class="stat-value">4</div>
            <div class="stat-note note-up">1 accepted</div>
          </div>
        </section>

        <section class="filters reveal-up delay-2">
          <select id="statusFilter" class="filter-select">
            <option value="">All interviews</option>
            <option value="today">Today</option>
            <option value="upcoming">Upcoming</option>
            <option value="completed">Completed</option>
          </select>

          <select id="roleFilter" class="filter-select">
            <option value="">All roles</option>
            <option value="frontend-developer">Frontend Developer</option>
            <option value="ai-engineer">AI Engineer</option>
            <option value="backend-engineer">Backend Engineer</option>
          </select>

          <button id="resetFilters" class="btn btn-outline btn-sm filter-reset">
            Reset filters
          </button>
        </section>

        <section id="interviewGrid" class="interview-grid">
          <!-- Rahul Sharma -->
          <article
            class="interview-card reveal-up delay-2"
            data-candidate="rahul-sharma"
            data-status="today"
            data-role="frontend-developer"
          >
            <div class="interview-head">
              <div class="date-card">
                <strong>10</strong>
                <span>Oct</span>
              </div>

              <div style="flex:1;">
                <h3 class="interview-title">Rahul Sharma</h3>
                <p class="interview-role">
                  Frontend Developer · Technical interview
                </p>
              </div>

              <span class="pill pill-today">Today</span>
            </div>

            <div class="interview-details">
              <div class="detail-row">
                <span>Time</span>
                <strong>2:00 PM – 3:00 PM</strong>
              </div>

              <div class="detail-row">
                <span>Interviewer</span>
                <strong>Amit Verma</strong>
              </div>

              <div class="detail-row">
                <span>Mode</span>
                <strong>Google Meet</strong>
              </div>
            </div>

            <div class="interview-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm profile-button"
              >
                View candidate
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm join-button"
              >
                Join interview
              </button>
            </div>
          </article>

          <!-- Priya Nair -->
          <article
            class="interview-card reveal-up delay-2"
            data-candidate="priya-nair"
            data-status="upcoming"
            data-role="ai-engineer"
          >
            <div class="interview-head">
              <div class="date-card">
                <strong>11</strong>
                <span>Oct</span>
              </div>

              <div style="flex:1;">
                <h3 class="interview-title">Priya Nair</h3>
                <p class="interview-role">
                  AI Engineer · Technical interview
                </p>
              </div>

              <span class="pill pill-upcoming">Upcoming</span>
            </div>

            <div class="interview-details">
              <div class="detail-row">
                <span>Time</span>
                <strong>3:30 PM – 4:30 PM</strong>
              </div>

              <div class="detail-row">
                <span>Interviewer</span>
                <strong>Rahul Joshi</strong>
              </div>

              <div class="detail-row">
                <span>Mode</span>
                <strong>Zoom</strong>
              </div>
            </div>

            <div class="interview-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm profile-button"
              >
                View candidate
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm join-button"
              >
                Join interview
              </button>
            </div>
          </article>

          <!-- Sneha Kapoor -->
          <article
            class="interview-card reveal-up delay-3"
            data-candidate="sneha-kapoor"
            data-status="upcoming"
            data-role="backend-engineer"
          >
            <div class="interview-head">
              <div class="date-card">
                <strong>12</strong>
                <span>Oct</span>
              </div>

              <div style="flex:1;">
                <h3 class="interview-title">Sneha Kapoor</h3>
                <p class="interview-role">
                  Backend Engineer · System design
                </p>
              </div>

              <span class="pill pill-upcoming">Upcoming</span>
            </div>

            <div class="interview-details">
              <div class="detail-row">
                <span>Time</span>
                <strong>10:30 AM – 11:30 AM</strong>
              </div>

              <div class="detail-row">
                <span>Interviewer</span>
                <strong>Neha Singh</strong>
              </div>

              <div class="detail-row">
                <span>Mode</span>
                <strong>Microsoft Teams</strong>
              </div>
            </div>

            <div class="interview-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm profile-button"
              >
                View candidate
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm join-button"
              >
                Join interview
              </button>
            </div>
          </article>

          <!-- Arjun Mehta -->
          <article
            class="interview-card reveal-up delay-3"
            data-candidate="arjun-mehta"
            data-status="completed"
            data-role="frontend-developer"
          >
            <div class="interview-head">
              <div class="date-card">
                <strong>08</strong>
                <span>Oct</span>
              </div>

              <div style="flex:1;">
                <h3 class="interview-title">Arjun Mehta</h3>
                <p class="interview-role">
                  Frontend Developer · Screening call
                </p>
              </div>

              <span class="pill pill-completed">Completed</span>
            </div>

            <div class="interview-details">
              <div class="detail-row">
                <span>Time</span>
                <strong>11:00 AM – 11:45 AM</strong>
              </div>

              <div class="detail-row">
                <span>Interviewer</span>
                <strong>Amit Verma</strong>
              </div>

              <div class="detail-row">
                <span>Result</span>
                <strong>Move to technical round</strong>
              </div>
            </div>

            <div class="interview-actions">
              <button
                type="button"
                class="btn btn-outline btn-sm profile-button"
              >
                View candidate
              </button>

              <button
                type="button"
                class="btn btn-primary btn-sm feedback-button"
              >
                Add feedback
              </button>
            </div>
          </article>
        </section>

        <div id="emptyState" class="empty-state">
          No interviews match the selected filters.
        </div>

        <section class="panel reveal-up delay-3" id="scheduleSection">
          <div class="panel-head">
            <div>
              <h2 class="panel-title">Schedule new interview</h2>
              <p class="panel-sub">
                Create an interview slot for a shortlisted candidate
              </p>
            </div>

            <span class="pill pill-upcoming">Demo form</span>
          </div>

          <form id="interviewForm">
            <div class="schedule-grid">
              <div class="field">
                <label for="candidateName">Candidate name</label>
                <input
                  id="candidateName"
                  type="text"
                  placeholder="Enter candidate name"
                  required
                />
              </div>

              <div class="field">
                <label for="candidateRole">Role</label>
                <select id="candidateRole" required>
                  <option value="">Select role</option>
                  <option value="Frontend Developer">
                    Frontend Developer
                  </option>
                  <option value="AI Engineer">AI Engineer</option>
                  <option value="Backend Engineer">
                    Backend Engineer
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="interviewDate">Date</label>
                <input id="interviewDate" type="date" required />
              </div>

              <div class="field">
                <label for="interviewTime">Time</label>
                <input id="interviewTime" type="time" required />
              </div>

              <div class="field">
                <label for="interviewerName">Interviewer</label>
                <input
                  id="interviewerName"
                  type="text"
                  placeholder="Enter interviewer name"
                  required
                />
              </div>

              <div class="field">
                <label for="interviewMode">Mode</label>
                <select id="interviewMode" required>
                  <option value="">Select mode</option>
                  <option value="Google Meet">Google Meet</option>
                  <option value="Zoom">Zoom</option>
                  <option value="Microsoft Teams">
                    Microsoft Teams
                  </option>
                  <option value="In-person">In-person</option>
                </select>
              </div>

              <div class="field" style="grid-column: 1 / -1;">
                <label for="interviewNotes">Notes</label>
                <textarea
                  id="interviewNotes"
                  placeholder="Add interview instructions or topics..."
                ></textarea>
              </div>
            </div>

            <button class="btn btn-primary" type="submit" style="margin-top:14px;">
              Schedule interview
            </button>
          </form>
        </section>
      </div>
    </main>
  </div>

  <script>
    const interviewCards = document.querySelectorAll(".interview-card");
    const emptyState = document.getElementById("emptyState");

    const searchInput = document.getElementById("interviewSearch");
    const statusFilter = document.getElementById("statusFilter");
    const roleFilter = document.getElementById("roleFilter");
    const resetFilters = document.getElementById("resetFilters");
    