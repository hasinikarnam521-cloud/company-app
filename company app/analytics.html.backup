<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Analytics — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --navy: #070d3f;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --vivid-blue: #1c19b8;
      --white: #ffffff;
      --light-blue: #e0e4f5;

      --ink: var(--deep-navy);
      --muted: #5b6b85;
      --line: var(--light-blue);
      --bg: #f7f9ff;
      --surface: var(--white);

      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 600px at 50% -20%, rgba(44, 131, 248, 0.08), transparent 70%),
        var(--bg);
      line-height: 1.65;
      min-height: 100vh;
      overflow-x: hidden;
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      background: var(--white);
      border-right: 1px solid var(--line);
      padding: 20px 16px;
      overflow-y: auto;
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
      padding: 10px 12px;
      margin-bottom: 18px;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.30);
      font-size: 18px;
    }

    .nav-list {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      transition: 0.2s ease;
      cursor: pointer;
    }

    .nav-item:hover {
      background: rgba(44, 131, 248, 0.06);
      color: var(--electric-blue);
    }

    .nav-item.active {
      background: linear-gradient(135deg, rgba(44, 131, 248, 0.12), rgba(39, 76, 220, 0.12));
      color: var(--royal-blue);
      font-weight: 600;
    }

    .nav-icon {
      width: 22px;
      text-align: center;
      font-size: 16px;
    }

    .nav-section {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .nav-section-title {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      padding: 6px 12px;
      margin-bottom: 6px;
    }

    /* Main content */
    .main-content {
      min-width: 0;
    }

    /* Top header */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(247, 249, 255, 0.85);
      border-bottom: 1px solid var(--line);
      padding: 14px 0;
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--white);
      color: var(--deep-navy);
      font-size: 13px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: 0.2s ease;
      text-decoration: none;
    }

    .back-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateX(-2px);
    }

    .page-title {
      font-family: "Sora", sans-serif;
      font-size: 20px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .search-wrap {
      flex: 1;
      max-width: 420px;
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      border: 1px solid var(--line);
      border-radius: 999px;
      font-size: 14px;
      font-family: inherit;
      color: var(--deep-navy);
      background: var(--white);
      transition: 0.2s ease;
    }

    .search-input:focus {
      outline: none;
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 15px;
      color: var(--muted);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--line);
      background: var(--white);
      display: grid;
      place-items: center;
      font-size: 17px;
      color: var(--muted);
      cursor: pointer;
      transition: 0.2s;
    }

    .icon-btn:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .avatar-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      color: var(--white);
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(44, 131, 248, 0.25);
    }

    /* Page content */
    .page-wrap {
      padding: 28px 0 60px;
    }

    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 18px;
    }

    .page-title-large {
      font-family: "Sora", sans-serif;
      font-size: 26px;
      letter-spacing: -1px;
      color: var(--deep-navy);
    }

    .page-sub {
      font-size: 13px;
      color: var(--muted);
    }

    .actions-right {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      border-radius: 999px;
      padding: 11px 18px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.25s ease;
      font-family: inherit;
      font-size: 13px;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.30);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 55px rgba(39, 76, 220, 0.35);
    }

    .btn-outline {
      background: var(--white);
      border: 1px solid var(--line);
      color: var(--deep-navy);
    }

    .btn-outline:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    /* Filters */
    .filters-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .filter-select {
      padding: 10px 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      font-size: 13px;
      font-family: inherit;
      color: var(--deep-navy);
      background: var(--white);
      transition: 0.2s ease;
    }

    .filter-select:focus {
      outline: none;
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    /* KPI grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 18px;
    }

    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .kpi-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 28px 80px rgba(5, 10, 48, 0.12);
    }

    .kpi-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.7px;
      margin-bottom: 8px;
    }

    .kpi-value {
      font-family: "Sora", sans-serif;
      font-size: 28px;
      letter-spacing: -1px;
      color: var(--deep-navy);
      margin-bottom: 6px;
    }

    .kpi-delta {
      font-size: 11px;
      color: var(--muted);
    }

    .delta-up {
      color: #059669;
    }

    .delta-down {
      color: #dc2626;
    }

    /* Charts grid */
    .charts-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      margin-bottom: 18px;
    }

    .chart-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
    }

    .chart-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .chart-title {
      font-family: "Sora", sans-serif;
      font-size: 16px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .chart-sub {
      font-size: 12px;
      color: var(--muted);
    }

    /* Simple bar chart */
    .bar-chart {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      height: 160px;
      padding-top: 10px;
    }

    .bar-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .bar {
      width: 100%;
      border-radius: 8px 8px 0 0;
      background: linear-gradient(180deg, var(--electric-blue), rgba(39, 76, 220, 0.35));
      transition: height 0.4s ease;
    }

    .bar-label {
      font-size: 11px;
      color: var(--muted);
      text-align: center;
    }

    /* AI insights panel */
    .ai-panel {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 20px;
      margin-bottom: 18px;
    }

    .ai-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .ai-title {
      font-family: "Sora", sans-serif;
      font-size: 16px;
      letter-spacing: -0.5px;
      color: var(--deep-navy);
    }

    .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(44, 131, 248, 0.08);
      border: 1px solid rgba(44, 131, 248, 0.25);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--royal-blue);
    }

    .insights-list {
      display: grid;
      gap: 12px;
    }

    .insight-card {
      display: flex;
      gap: 12px;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--white);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .insight-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 45px rgba(5, 10, 48, 0.08);
    }

    .insight-icon {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      display: grid;
      place-items: center;
      font-size: 17px;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
      box-shadow: 0 8px 20px rgba(44, 131, 248, 0.25);
      flex: 0 0 38px;
    }

    .insight-text strong {
      display: block;
      font-size: 13px;
      color: var(--deep-navy);
      margin-bottom: 4px;
    }

    .insight-text span {
      font-size: 12px;
      color: var(--muted);
    }

    /* Animations */
    .reveal-up {
      opacity: 0;
      transform: translateY(16px);
      animation: revealUp 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.06s;
    }

    .delay-2 {
      animation-delay: 0.12s;
    }

    .delay-3 {
      animation-delay: 0.18s;
    }

    /* Responsive */
    @media (max-width: 1000px) {
      body {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: relative;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      .nav-list {
        grid-template-columns: repeat(2, 1fr);
      }

      .kpi-grid,
      .charts-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .nav-list {
        grid-template-columns: 1fr;
      }

      .search-wrap {
        order: 3;
        max-width: 100%;
        margin: 10px 0 0;
        width: 100%;
      }

      .topbar-inner {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">V</div>
      <span>VENTRIXCARROS</span>
    </div>

    <nav class="nav-list">
      <div class="nav-item">
        <span class="nav-icon">🏠</span>
        Dashboard
      </div>
      <div class="nav-item">
        <span class="nav-icon">🤖</span>
        AI Recruitment
      </div>
      <div class="nav-item">
        <span class="nav-icon">💼</span>
        Jobs
      </div>
      <div class="nav-item">
        <span class="nav-icon">👥</span>
        Candidates
      </div>
      <div class="nav-item">
        <span class="nav-icon">📋</span>
        Applications
      </div>
      <div class="nav-item">
        <span class="nav-icon">⭐</span>
        Shortlisted
      </div>
      <div class="nav-item">
        <span class="nav-icon">🎤</span>
        Interviews
      </div>
      <div class="nav-item">
        <span class="nav-icon">💬</span>
        Messages
      </div>
      <div class="nav-item active">
        <span class="nav-icon">📊</span>
        Analytics
      </div>

      <div class="nav-section">
        <div class="nav-section-title">Account</div>
        <div class="nav-item">
          <span class="nav-icon">💳</span>
          Subscription
        </div>
        <div class="nav-item">
          <span class="nav-icon">🏢</span>
          Company Profile
        </div>
        <div class="nav-item">
          <span class="nav-icon">⚙️</span>
          Settings
        </div>
      </div>
    </nav>
  </aside>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <a href="dashboard.html" class="back-btn">
            ← Back
          </a>
          <div class="page-title">Analytics</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            class="search-input"
            type="text"
            placeholder="Search analytics..."
          />
        </div>

        <div class="nav-right">
          <button class="icon-btn" title="Notifications">🔔</button>
          <div class="avatar-btn" title="Profile">VC</div>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="page-wrap">
      <div class="container">
        <!-- Page head -->
        <div class="page-head reveal-up">
          <div>
            <h1 class="page-title-large">Analytics</h1>
            <p class="page-sub">
              Track hiring performance and get AI-powered recommendations to improve outcomes.
            </p>
          </div>

          <div class="actions-right">
            <button class="btn btn-outline">📥 Export report</button>
            <button class="btn btn-primary">🧠 Ask AI insights</button>
          </div>
        </div>

        <!-- Filters -->
        <div class="filters-bar reveal-up delay-1">
          <select class="filter-select">
            <option>Last 30 days</option>
            <option>Last 7 days</option>
            <option>Last 90 days</option>
            <option>This year</option>
          </select>
          <select class="filter-select">
            <option>All jobs</option>
            <option>Frontend Developer</option>
            <option>Backend Engineer</option>
            <option>AI Engineer</option>
            <option>Product Designer</option>
          </select>
          <select class="filter-select">
            <option>All departments</option>
            <option>Engineering</option>
            <option>Product</option>
            <option>Design</option>
          </select>
        </div>

        <!-- KPI cards -->
        <div class="kpi-grid">
          <div class="kpi-card reveal-up delay-1">
            <div class="kpi-label">Avg time-to-hire</div>
            <div class="kpi-value">21 days</div>
            <div class="kpi-delta delta-down">↓ 3 days vs last period</div>
          </div>

          <div class="kpi-card reveal-up delay-2">
            <div class="kpi-label">Offer acceptance rate</div>
            <div class="kpi-value">82%</div>
            <div class="kpi-delta delta-up">↑ 5% vs last period</div>
          </div>

          <div class="kpi-card reveal-up delay-3">
            <div class="kpi-label">Top source</div>
            <div class="kpi-value">Referrals</div>
            <div class="kpi-delta">42% of hires</div>
          </div>

          <div class="kpi-card reveal-up delay-3">
            <div class="kpi-label">Pipeline health</div>
            <div class="kpi-value">Good</div>
            <div class="kpi-delta">Balanced funnel</div>
          </div>
        </div>

        <!-- Charts -->
        <div class="charts-grid">
          <!-- Applications over time -->
          <div class="chart-card reveal-up delay-2">
            <div class="chart-head">
              <div>
                <div class="chart-title">Applications over time</div>
                <div class="chart-sub">Last 6 weeks</div>
              </div>
            </div>

            <div class="bar-chart">
              <div class="bar-col">
                <div class="bar" style="height: 40%;"></div>
                <div class="bar-label">W1</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 60%;"></div>
                <div class="bar-label">W2</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 55%;"></div>
                <div class="bar-label">W3</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 80%;"></div>
                <div class="bar-label">W4</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 70%;"></div>
                <div class="bar-label">W5</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 100%;"></div>
                <div class="bar-label">W6</div>
              </div>
            </div>
          </div>

          <!-- Conversion funnel -->
          <div class="chart-card reveal-up delay-3">
            <div class="chart-head">
              <div>
                <div class="chart-title">Conversion funnel</div>
                <div class="chart-sub">Application → Hire</div>
              </div>
            </div>

            <div class="bar-chart">
              <div class="bar-col">
                <div class="bar" style="height: 100%;"></div>
                <div class="bar-label">Applied</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 70%;"></div>
                <div class="bar-label">Screened</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 50%;"></div>
                <div class="bar-label">Interview</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 30%;"></div>
                <div class="bar-label">Offer</div>
              </div>
              <div class="bar-col">
                <div class="bar" style="height: 25%;"></div>
                <div class="bar-label">Hired</div>
              </div>
            </div>
          </div>
        </div>

        <!-- AI Insights -->
        <section class="ai-panel reveal-up delay-3">
          <div class="ai-head">
            <div>
              <div class="ai-title">AI Insights</div>
              <div class="chart-sub">
                Recommendations to improve your hiring process
              </div>
            </div>
            <span class="ai-badge">● AI Active</span>
          </div>

          <div class="insights-list">
            <div class="insight-card">
              <div class="insight-icon">⏱</div>
              <div class="insight-text">
                <strong>Reduce time-to-hire for engineering roles</strong>
                <span>
                  Engineering roles take 26 days on average vs 18 days for other teams.
                  Automate initial screening and schedule interviews faster.
                </span>
              </div>
            </div>

            <div class="insight-card">
              <div class="insight-icon">🎯</div>
              <div class="insight-text">
                <strong>Improve offer acceptance rate</strong>
                <span>
                  Candidates who receive an offer within 7 days of final interview
                  accept 90% of the time. Speed up decision-making post-interview.
                </span>
              </div>
            </div>

            <div class="insight-card">
              <div class="insight-icon">📣</div>
              <div class="insight-text">
                <strong>Double down on referrals</strong>
                <span>
                  Referrals convert to hires at 3x the rate of other sources.
                  Consider a small referral bonus to encourage more employee referrals.
                </span>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    // Highlight active nav item
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
      });
    });

    // Demo: wire AI / export buttons
    document.querySelectorAll('.btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const text = e.target.textContent.trim();
        if (text.includes('AI') || text.includes('Export')) {
          console.log('Action:', text);
          alert(`Action: ${text}\n\n(Connect to your backend / AI service to implement.)`);
        }
      });
    });
  </script>
</body>
</html>