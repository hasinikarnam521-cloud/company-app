  <script>
    // Highlight active nav item
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
      });
    });

    // Bulk selection logic
    const selectAll = document.getElementById('selectAll');
    const rowCheckboxes = document.querySelectorAll('.row-checkbox');
    const bulkBar = document.getElementById('bulkBar');
    const bulkText = document.getElementById('bulkText');

    function updateBulkBar() {
      const checked = document.querySelectorAll('.row-checkbox:checked').length;
      if (checked > 0) {
        bulkBar.classList.add('visible');
        bulkText.textContent = `${checked} candidate${checked > 1 ? 's' : ''} selected`;
      } else {
        bulkBar.classList.remove('visible');
      }
    }

    selectAll.addEventListener('change', () => {
      rowCheckboxes.forEach(cb => (cb.checked = selectAll.checked));
      updateBulkBar();
    });

    rowCheckboxes.forEach(cb => {
      cb.addEventListener('change', updateBulkBar);
    });

    // Demo: wire AI action buttons
    document.querySelectorAll('.ai-actions .btn, .bulk-actions .btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const action = e.target.textContent.trim();
        const selected = document.querySelectorAll('.row-checkbox:checked');
        if (selected.length === 0) {
          alert('Select one or more candidates first.');
          return;
        }
        const names = Array.from(selected)
          .map(cb => cb.closest('tr').querySelector('.candidate-info strong').textContent)
          .join(', ');

        console.log(`Action: ${action}\nCandidates: ${names}`);
        alert(`Action: ${action}\nCandidates: ${names}\n\n(Connect to your AI backend to implement.)`);
      });
    });
  </script>
</body>
</html>