<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VentrixCarros — Hire Exceptional Talent</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --navy: #070d3f;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --vivid-blue: #1c19b8;
      --white: #ffffff;
      --light-blue: #e0e4f5;

      --ink: var(--deep-navy);
      --muted: #5b6b85;
      --line: var(--light-blue);
      --bg: var(--white);
      --surface: var(--light-blue);

      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--ink);
      background: var(--bg);
      line-height: 1.65;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Loading screen */
    #loadingScreen {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: grid;
      place-items: center;
      background:
        radial-gradient(700px 500px at 20% 20%, rgba(44, 131, 248, 0.18), transparent),
        radial-gradient(600px 450px at 80% 80%, rgba(28, 25, 184, 0.22), transparent),
        var(--deep-navy);
      transition: opacity 0.6s ease, visibility 0.6s ease;
    }

    #loadingScreen.hidden {
      opacity: 0;
      visibility: hidden;
    }

    .loader-box {
      width: min(420px, 90%);
      text-align: center;
      animation: fadeUp 0.8s ease both;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .loader-logo {
      width: 78px;
      height: 78px;
      margin: 0 auto 28px;
      border-radius: 24px;
      display: grid;
      place-items: center;
      font-family: "Sora", sans-serif;
      font-size: 30px;
      font-weight: 800;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue), var(--vivid-blue));
      box-shadow:
        0 20px 55px rgba(44, 131, 248, 0.35),
        inset 0 0 0 1px rgba(255, 255, 255, 0.12);
      animation: logoPulse 2.2s ease-in-out infinite;
    }

    @keyframes logoPulse {
      0%, 100% {
        transform: scale(1);
        box-shadow:
          0 20px 55px rgba(44, 131, 248, 0.35),
          inset 0 0 0 1px rgba(255, 255, 255, 0.12);
      }

      50% {
        transform: scale(1.05);
        box-shadow:
          0 26px 70px rgba(44, 131, 248, 0.48),
          inset 0 0 0 1px rgba(255, 255, 255, 0.18);
      }
    }

    .loader-brand {
      font-family: "Sora", sans-serif;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 3px;
      color: var(--white);
      margin-bottom: 8px;
    }

    .loader-subtext {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.62);
      margin-bottom: 34px;
    }

    .progress-track {
      width: 100%;
      height: 8px;
      border-radius: 999px;
      background: rgba(224, 228, 245, 0.14);
      overflow: hidden;
    }

    .progress-fill {
      width: 0%;
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--electric-blue), var(--royal-blue), var(--vivid-blue));
      box-shadow: 0 0 18px rgba(44, 131, 248, 0.55);
      transition: width 0.35s ease;
    }

    .progress-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.60);
    }

    #loadingPercent {
      font-family: "Sora", sans-serif;
      font-weight: 700;
      color: var(--white);
    }

    /* Header */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(18px);
      background: rgba(255, 255, 255, 0.85);
      border-bottom: 1px solid var(--light-blue);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 0;
    }

    .brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: "Sora", sans-serif;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: var(--deep-navy);
}

.brand-logo {
  width: 44px;
  height: 44px;
  object-fit: contain;
  border-radius: 10px;
  display: block;
}

    .nav {
      display: flex;
      align-items: center;
      gap: 30px;
    }

    .nav a {
      font-size: 14px;
      font-weight: 500;
      color: var(--muted);
      transition: 0.2s;
    }

    .nav a:hover {
      color: var(--electric-blue);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
      border-radius: 999px;
      padding: 14px 27px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.25s ease;
    }

    .btn-primary {
     color: #ffffff;
     background: #3b82f6;
     border: 2px solid #3b82f6;
     padding: 12px 24px;
     border-radius: 14px;
     font-weight: 600;
     box-shadow: 0 8px 22px rgba(59, 130, 246, 0.20);
     transition: all 0.3s ease;
   }

.btn-primary:hover {
  background: #2563eb;
  border-color: #2539eb;
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(59, 130, 246, 0.30);
}
.nav .btn-start {
  color: #ffffff;
  background: #3b82f6;
  border: 2px solid #3b82f6;
  padding: 12px 24px;
  border-radius: 14px;
  font-weight: 800;
  box-shadow: 0 8px 22px rgba(59, 130, 246, 0.20);
  transition: all 0.3s ease;
}

.nav .btn-start:hover {
  color: #ffffff;
  background: #2563eb;
  border-color: #2563eb;
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(59, 130, 246, 0.30);
}
.btn-start:hover {
  color: #2563eb;
  background: transparent;
  transform: translateY(-1px);
}

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 22px 60px rgba(39, 76, 220, 0.35);
    }

    .btn-outline {
      background: var(--white);
      border: 1px solid var(--light-blue);
      color: var(--deep-navy);
    }

    .btn-outline:hover {
      border-color: var(--electric-blue);
      color: var(--electric-blue);
      transform: translateY(-2px);
    }

    /* Hero */
    .hero {
      position: relative;
      padding: 150px 0 110px;
      background:
        radial-gradient(700px 450px at 10% 10%, rgba(44, 131, 248, 0.10), transparent),
        radial-gradient(600px 400px at 90% 20%, rgba(224, 228, 245, 0.75), transparent);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 80px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 17px;
      border-radius: 999px;
      background: var(--light-blue);
      border: 1px solid rgba(44, 131, 248, 0.20);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--royal-blue);
      margin-bottom: 28px;
    }

    .hero h1 {
      font-family: "Sora", sans-serif;
      font-size: clamp(44px, 6.5vw, 78px);
      line-height: 1.02;
      letter-spacing: -3px;
      margin-bottom: 24px;
      color: var(--deep-navy);
    }

    .gradient-text {
      background: linear-gradient(90deg, var(--electric-blue), var(--royal-blue), var(--vivid-blue));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      max-width: 520px;
      color: var(--muted);
      font-size: 18px;
      margin-bottom: 38px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 55px;
    }

    .proof {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .avatars {
      display: flex;
    }

    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 3px solid var(--white);
      margin-left: -12px;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
    }

    .avatar:first-child {
      margin-left: 0;
    }

    .proof strong {
      display: block;
      font-size: 14px;
      color: var(--deep-navy);
    }

    .proof span {
      font-size: 13px;
      color: var(--muted);
    }

    /* Floating dashboard */
    .dashboard {
      position: relative;
      animation: floatCard 8s ease-in-out infinite;
    }

    @keyframes floatCard {
      0%, 100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-16px);
      }
    }

    .dashboard-card {
      position: relative;
      background: var(--white);
      border: 1px solid var(--light-blue);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 28px;
    }

    .dashboard-card::before {
      content: "";
      position: absolute;
      inset: -2px;
      border-radius: 26px;
      background: linear-gradient(135deg, rgba(44, 131, 248, 0.35), rgba(28, 25, 184, 0.25), transparent);
      z-index: -1;
      filter: blur(1px);
    }

    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 24px;
    }

    .card-title {
      font-family: "Sora", sans-serif;
      font-weight: 700;
      color: var(--deep-navy);
    }

    .live {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: #ecfdf5;
      color: #059669;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
    }

    .metric-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 22px;
    }

    .metric {
      background: var(--white);
      border: 1px solid var(--light-blue);
      border-radius: 18px;
      padding: 18px;
    }

    .metric strong {
      display: block;
      font-family: "Sora", sans-serif;
      font-size: 28px;
      color: var(--deep-navy);
    }

    .metric span {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .candidate {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 17px;
      border: 1px solid var(--light-blue);
      border-radius: 18px;
      margin-bottom: 10px;
      background: var(--white);
      transition: 0.25s ease;
    }

    .candidate:hover {
      transform: translateX(6px);
      border-color: rgba(44, 131, 248, 0.45);
    }

    .candidate-info strong {
      display: block;
      font-size: 14px;
      color: var(--deep-navy);
    }

    .candidate-info span {
      font-size: 12px;
      color: var(--muted);
    }

    .score {
      font-family: "Sora", sans-serif;
      font-weight: 700;
    }

    .score-high {
      color: var(--electric-blue);
    }

    .score-medium {
      color: var(--royal-blue);
    }

    .score-low {
      color: var(--vivid-blue);
    }

    /* Strip */
    .strip {
      padding: 20px 0 90px;
    }

    .strip-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 28px;
      color: var(--muted);
      font-family: "Sora", sans-serif;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    /* Sections */
    .section {
      padding: 100px 0;
    }

    .section-head {
      max-width: 660px;
      margin: 0 auto 60px;
      text-align: center;
    }

    .section-head h2 {
      font-family: "Sora", sans-serif;
      font-size: clamp(30px, 4.5vw, 52px);
      letter-spacing: -2px;
      margin-bottom: 14px;
      color: var(--deep-navy);
    }

    .section-head p {
      color: var(--muted);
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .feature-card {
      position: relative;
      background: var(--white);
      border: 1px solid var(--light-blue);
      border-radius: var(--radius);
      padding: 32px;
      transition: 0.25s ease;
    }

    .feature-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow);
    }

    .feature-card.wide {
      grid-column: span 2;
    }

    .feature-icon {
  width: 80px;
  height: 80px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  margin-bottom: 22px;
  background: transparent;
  box-shadow: none;
  overflow: hidden;
}

.feature-icon img {
  width: 80px;
  height: 80px;
  object-fit: contain;
  display: block;
}

    .feature-card h3 {
      font-family: "Sora", sans-serif;
      margin-bottom: 10px;
      color: var(--deep-navy);
    }

    .feature-card p {
      color: var(--muted);
    }

    .mini-chart {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      height: 140px;
      margin-top: 30px;
    }

    .bar {
      flex: 1;
      border-radius: 12px 12px 0 0;
      background: linear-gradient(180deg, var(--electric-blue), rgba(39, 76, 220, 0.35));
    }

    /* Workflow */
    .workflow {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .step {
      background: var(--white);
      border: 1px solid var(--light-blue);
      border-radius: var(--radius);
      padding: 28px;
      transition: 0.25s ease;
    }

    .step:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow);
    }

    .step-number {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      color: var(--white);
      font-weight: 700;
      margin-bottom: 20px;
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
    }

    .step h3 {
      font-family: "Sora", sans-serif;
      margin-bottom: 8px;
      color: var(--deep-navy);
    }

    .step p {
      color: var(--muted);
      font-size: 14px;
    }

    /* Pricing */
    .price-card {
      max-width: 440px;
      margin-inline: auto;
      background: var(--navy);
      color: var(--white);
      border: 1px solid rgba(224, 228, 245, 0.15);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 48px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .price-card::before {
      content: "";
      position: absolute;
      width: 350px;
      height: 350px;
      top: -150px;
      right: -120px;
      background: rgba(44, 131, 248, 0.30);
      border-radius: 50%;
      filter: blur(70px);
    }

    .price {
      font-family: "Sora", sans-serif;
      font-size: 72px;
      font-weight: 800;
      letter-spacing: -3px;
      color: var(--white);
    }

    .price-period {
      color: rgba(255, 255, 255, 0.65);
    }

    .price-list {
      margin: 30px 0;
      text-align: left;
    }

    .price-list li {
      padding: 12px 0;
      border-bottom: 1px solid rgba(224, 228, 245, 0.15);
      color: rgba(255, 255, 255, 0.78);
    }

    .price-list li::before {
      content: "✔";
      color: var(--electric-blue);
      margin-right: 10px;
      font-weight: 700;
    }

    .btn-light {
      width: 100%;
      color: var(--white);
      background: linear-gradient(135deg, var(--electric-blue), var(--royal-blue));
    }

    /* CTA */
    .final-cta {
      background: var(--white);
      border-top: 1px solid var(--light-blue);
      padding: 110px 0;
      text-align: center;
    }

    .final-cta h2 {
      font-family: "Sora", sans-serif;
      font-size: clamp(32px, 5vw, 62px);
      letter-spacing: -3px;
      margin-bottom: 18px;
      color: var(--deep-navy);
    }

    .final-cta p {
      max-width: 580px;
      margin: 0 auto 35px;
      color: var(--muted);
    }

    /* Footer */
    .footer {
      background: var(--deep-navy);
      border-top: 1px solid rgba(224, 228, 245, 0.15);
      padding: 34px 0;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.70);
    }

    .footer-links {
      display: flex;
      gap: 22px;
    }

    .footer a:hover {
      color: var(--electric-blue);
    }

    /* Responsive */
    @media (max-width: 1000px) {
      .hero-grid,
      .feature-grid {
        grid-template-columns: 1fr;
      }

      .feature-card.wide {
        grid-column: span 1;
      }

      .workflow {
        grid-template-columns: repeat(2, 1fr);
      }

      .nav {
        display: none;
      }
    }

    @media (max-width: 600px) {
      .workflow {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 120px 0 80px;
      }

      .metric-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <!-- Loading Screen -->
  <div id="loadingScreen">
    <div class="loader-box">
      <div class="loader-logo">
        <span>V</span>
      </div>

      <div class="loader-brand">VENTRIXCARROS</div>
      <div class="loader-subtext">Preparing your AI hiring workspace</div>

      <div class="progress-track">
        <div class="progress-fill" id="progressFill"></div>
      </div>

      <div class="progress-meta">
        <span id="loadingStatus">Initialising platform</span>
        <span id="loadingPercent">0%</span>
      </div>
    </div>
  </div>

  <!-- Header -->
<header class="header">
  <div class="container header-inner">
    <div class="brand">
      <img src="./logo.jpeg" alt="VentrixCarros Logo" class="brand-logo">
      VentrixCarros
    </div>

      <nav class="nav">
        <a href="#features">Features</a>
        <a href="#workflow">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="login.html">Log in</a>
        <a href="signup.html" class="btn btn-start">Get started</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <span class="pill">● AI Recruitment Intelligence</span>

          <h1>
            Hire exceptional talent, <span class="gradient-text">faster.</span>
          </h1>

          <p>
            VentrixCarros brings jobs, candidates, applications, interviews, and
            hiring insights into one clean company dashboard.
          </p>

          <div class="hero-actions">
            <a href="signup.html" class="btn btn-primary">Create company account</a>
            <a href="#features" class="btn btn-outline">Explore features</a>
          </div>

          <div class="proof">
            <div class="avatars">
              <span class="avatar"></span>
              <span class="avatar"></span>
              <span class="avatar"></span>
            </div>

            <div>
              <strong>Trusted by growing teams</strong>
              <span>2,500+ jobs published</span>
            </div>
          </div>
        </div>

        <div class="dashboard">
          <div class="dashboard-card">
            <div class="card-head">
              <span class="card-title">Recruitment Overview</span>
              <span class="live">● AI Screening Active</span>
            </div>

            <div class="metric-row">
              <div class="metric">
                <strong>42</strong>
                <span>Applications</span>
              </div>

              <div class="metric">
                <strong>12</strong>
                <span>Shortlisted</span>
              </div>

              <div class="metric">
                <strong>5</strong>
                <span>Interviews</span>
              </div>
            </div>

            <div class="candidate">
              <div class="candidate-info">
                <strong>Rahul Sharma</strong>
                <span>Frontend Developer</span>
              </div>

              <span class="score-high">94%</span>
            </div>

            <div class="candidate">
              <div class="candidate-info">
                <strong>Priya Nair</strong>
                <span>AI Engineer</span>
              </div>

              <span class="score-medium">88%</span>
            </div>

            <div class="candidate">
              <div class="candidate-info">
                <strong>Arjun Mehta</strong>
                <span>Frontend Developer</span>
              </div>

              <span class="score-high">82%</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Company strip -->
    <section class="strip">
      <div class="container strip-inner">
        <span>StartupHub</span>
        <span>TechNest</span>
        <span>HirePro</span>
        <span>GrowthLab</span>
        <span>TalentX</span>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="section">
      <div class="container">
        <div class="section-head">
          <h2>Everything your HR team needs</h2>

          <p>
            Post roles, screen candidates automatically, schedule interviews, and
            track hiring performance in one place.
          </p>
        </div>

        <div class="feature-grid">
  <article class="feature-card wide">
