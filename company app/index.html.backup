  <script>
    window.addEventListener("DOMContentLoaded", () => {
      const loadingScreen = document.getElementById("loadingScreen");
      const progressFill = document.getElementById("progressFill");
      const loadingPercent = document.getElementById("loadingPercent");
      const loadingStatus = document.getElementById("loadingStatus");

      const messages = [
        "Initialising platform",
        "Loading recruitment modules",
        "Preparing AI screening",
        "Connecting dashboard",
        "Almost ready"
      ];

      let progress = 0;
      let messageIndex = 0;

      const loadingInterval = setInterval(() => {
        progress += Math.random() * 12 + 6;

        if (progress >= 100) {
          progress = 100;
          clearInterval(loadingInterval);

          loadingStatus.textContent = "Welcome to VentrixCarros";

          setTimeout(() => {
            loadingScreen.classList.add("hidden");
          }, 700);
        }

        progressFill.style.width = progress + "%";
        loadingPercent.textContent = Math.floor(progress) + "%";

        const nextMessage = Math.floor(progress / 20);

        if (nextMessage < messages.length && nextMessage !== messageIndex) {
          messageIndex = nextMessage;
          loadingStatus.textContent = messages[messageIndex];
        }
      }, 260);
    });
  </script>
</body>
</html>