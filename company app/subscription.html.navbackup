<path d="M3 10h18"></path>
<path d="M7 15h4"></path>
</svg>
</span>
          Subscription
        </div>
        <div class="nav-item">
          <span class="nav-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path>
<path d="M2 21h20"></path>
<path d="M8 7h2"></path>
<path d="M8 11h2"></path>
<path d="M8 15h2"></path>
<path d="M16 9h2"></path>
<path d="M16 13h2"></path>
<path d="M16 17h2"></path>
</svg>
</span>
          Company Profile
        </div>
        <div class="nav-item">
          <span class="nav-icon">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<circle cx="12" cy="12" r="3"></circle>
<path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V20h-2.6v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2.6h.4A1.7 1.7 0 0 0 8 10a1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6V5H15v.1a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.4V14h-.4a1.7 1.7 0 0 0-1.6 1z"></path>
</svg>
</span>
          Settings
        </div>
      </div>
    </nav>
  </aside>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top bar -->
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="topbar-left">
          <a href="dashboard.html" class="back-btn">
            ← Back
          </a>
          <div class="page-title">Subscription</div>
        </div>

        <div class="search-wrap">
          <span class="search-icon">🔎</span>
          <input
            class="search-input"
            type="text"
            placeholder="Search billing, invoices..."
          />
        </div>

        <div class="nav-right">
          <button class="icon-btn" title="Notifications">🔔</button>
          <div class="avatar-btn" title="Profile">VC</div>
        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="page-wrap">
      <div class="container">
        <!-- Page head -->
        <div class="page-head reveal-up">
          <div>
            <h1 class="page-title-large">Subscription</h1>
            <p class="page-sub">
              Manage your plan, payment method, and billing history.
            </p>
          </div>

          <div class="actions-right">
            <button class="btn btn-outline">📥 Download invoice</button>
            <button class="btn btn-primary">💬 Contact support</button>
          </div>
        </div>

        <div class="section-grid">
          <!-- Left: Current plan + features -->
          <div>
            <!-- Current plan -->
            <section class="panel reveal-up delay-1">
              <div class="panel-head">
                <div>
                  <div class="panel-title">Current plan</div>
                  <div class="panel-sub">Active subscription details</div>
                </div>
                <span class="plan-badge">Active</span>
              </div>

              <div class="plan-summary">
                <div>
                  <div class="plan-name">Company Plan — ₹499/month</div>
                  <div class="plan-desc">
                    Full access to all features. Next billing on Nov 1, 2026.
                  </div>
                </div>
                <div class="actions-right">
                  <button class="btn btn-outline">Manage auto-renewal</button>
                  <button class="btn btn-outline">Cancel plan</button>
                </div>
              </div>

              <div class="usage-row">
                <div class="usage-card">
                  <div class="usage-label">Jobs posted</div>
                  <div class="usage-value">12</div>
                  <div class="usage-sub">Unlimited on this plan</div>
                </div>

                <div class="usage-card">
                  <div class="usage-label">AI screenings</div>
                  <div class="usage-value">184</div>
                  <div class="usage-sub">This billing period</div>
                </div>

                <div class="usage-card">
                  <div class="usage-label">Team members</div>
                  <div class="usage-value">3</div>
                  <div class="usage-sub">Multiple seats allowed</div>
                </div>
              </div>
            </section>

            <!-- What’s included -->
            <section class="panel reveal-up delay-2" style="margin-top: 18px;">
              <div class="panel-head">
                <div>
                  <div class="panel-title">What’s included</div>
                  <div class="panel-sub">All features at one simple price</div>
                </div>
              </div>

              <div class="plan-features" style="display: grid; gap: 8px;">
                <div class="plan-feature" style="display:flex; gap:8px; font-size:13px; color:var(--muted);">
                  <span style="color:var(--electric-blue); font-weight:700;">✔</span>
                  Unlimited job postings
                </div>
                <div class="plan-feature" style="display:flex; gap:8px; font-size:13px; color:var(--muted);">
                  <span style="color:var(--electric-blue); font-weight:700;">✔</span>
                  AI candidate screening & match scores
                </div>
                <div class="plan-feature" style="display:flex; gap:8px; font-size:13px; color:var(--muted);">
                  <span style="color:var(--electric-blue); font-weight:700;">✔</span>
                  Interview scheduling & feedback
                </div>
                <div class="plan-feature" style="display:flex; gap:8px; font-size:13px; color:var(--muted);">
                  <span style="color:var(--electric-blue); font-weight:700;">✔</span>
                  Analytics dashboard & reports
                </div>
                <div class="plan-feature" style="display:flex; gap:8px; font-size:13px; color:var(--muted);">
                  <span style="color:var(--electric-blue); font-weight:700;">✔</span>
                  Messages & team collaboration
                </div>
                <div class="plan-feature" style="display:flex; gap:8px; font-size:13px; color:var(--muted);">
                  <span style="color:var(--electric-blue); font-weight:700;">✔</span>
                  Email support
                </div>
              </div>
            </section>
          </div>

          <!-- Right: Payment & billing -->
          <div>
            <!-- Payment method -->
            <section class="panel reveal-up delay-2">
              <div class="panel-head">
                <div>
                  <div class="panel-title">Payment method</div>
                  <div class="panel-sub">Card used for billing</div>
                </div>
                <button class="btn btn-outline btn-sm">Edit</button>
              </div>

              <div class="payment-row">
                <div class="payment-info">
                  <strong>Visa •••• 4242</strong>
                  <span>Expires 12/2027</span>
                </div>
                <button class="btn btn-outline btn-sm">Update</button>
              </div>

              <div class="panel-sub" style="margin-top: 10px;">
                Next payment of ₹499 will be charged on Nov 1, 2026.
              </div>
            </section>

            <!-- Billing history -->
            <section class="panel reveal-up delay-3" style="margin-top: 18px;">
              <div class="panel-head">
                <div>
                  <div class="panel-title">Billing history</div>
                  <div class="panel-sub">Past invoices and payments</div>
                </div>
                <button class="btn btn-outline btn-sm">Export CSV</button>
              </div>

              <div class="table-wrap">
                <table class="billing-table">
                  <thead>
                    <tr>
                      <th>Date</th>
                      <th>Amount</th>
                      <th>Status</th>
                      <th>Invoice</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>Oct 1, 2026</td>
                      <td>₹499</td>
                      <td>Paid</td>
                      <td><button class="btn btn-outline btn-sm">Download</button></td>
                    </tr>
                    <tr>
                      <td>Sep 1, 2026</td>
                      <td>₹499</td>
                      <td>Paid</td>
                      <td><button class="btn btn-outline btn-sm">Download</button></td>
                    </tr>
                    <tr>
                      <td>Aug 1, 2026</td>
                      <td>₹499</td>
                      <td>Paid</td>
                      <td><button class="btn btn-outline btn-sm">Download</button></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </section>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    // Highlight active nav item
    document.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        item.classList.add('active');
      });
    });

    // Demo: wire buttons
    document.querySelectorAll('.btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const text = e.target.textContent.trim();
        if (text.includes('Download') || text.includes('Contact') || text.includes('Cancel')) {
          console.log('Action:', text);
          alert(`Action: ${text}\n\n(Connect to your billing / support backend to implement.)`);
        }
      });
    });
  </script>
</body>
</html>