          <span class="nav-icon">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path>
    <path d="M2 21h20"></path>
    <path d="M8 7h2"></path>
    <path d="M8 11h2"></path>
    <path d="M8 15h2"></path>
