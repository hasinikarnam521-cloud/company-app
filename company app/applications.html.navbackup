<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Applications — VentrixCarros</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --deep-navy: #050a30;
      --electric-blue: #2c83f8;
      --royal-blue: #274cdc;
      --white: #ffffff;
      --light-blue: #e0e4f5;
      --muted: #5b6b85;
      --bg: #f7f9ff;
      --green: #059669;
      --orange: #d97706;
      --red: #dc2626;
      --line: var(--light-blue);
      --radius: 24px;
      --shadow: 0 24px 70px rgba(5, 10, 48, 0.10);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--deep-navy);
      font-family: "Inter", sans-serif;
      line-height: 1.65;
      background:
        radial-gradient(
          900px 600px at 50% -20%,
          rgba(44, 131, 248, 0.08),
          transparent 70%
        ),
        var(--bg);
      display: grid;
      grid-template-columns: 260px 1fr;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select {
      font: inherit;
    }

    .container {
      width: min(1200px, 100% - 40px);
      margin-inline: auto;
    }

    /* Sidebar */
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 20px 16px;
      overflow-y: auto;
      background: var(--white);
      border-right: 1px solid var(--line);
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      margin-bottom: 18px;
      font-family: "Sora", sans-serif;
      font-weight: 800;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      color: var(--white);
      font-weight: 700;
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
      box-shadow: 0 10px 28px rgba(44, 131, 248, 0.3);
    }

    .nav-list {
      display: grid;
      gap: 6px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      border-radius: 12px;
      color: var(--muted);
      font-size: 14px;
      font-weight: 500;
      transition: 0.2s ease;
    }

    .nav-item:hover {
      color: var(--electric-blue);
      background: rgba(44, 131, 248, 0.06);
    }

    .nav-item.active {
      color: var(--royal-blue);
      font-weight: 600;
      background: linear-gradient(
        135deg,
        rgba(44, 131, 248, 0.12),
        rgba(39, 76, 220, 0.12)
      );
    }

    .nav-icon {
  width: 22px;
  height: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

    .nav-section {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
    }

    .nav-section-title {
      padding: 6px 12px;
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.7px;
      text-transform: uppercase;
    }

    /* Topbar */
    .main-content {
      min-width: 0;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      padding: 14px 0;
      backdrop-filter: blur(18px);
      background: rgba(247, 249, 255, 0.86);
      border-bottom: 1px solid var(--line);
    }

    .topbar-inner {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .back-btn,
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 600;
      transition: 0.25s ease;
    }

    .back-btn {
      padding: 9px 14px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      font-size: 13px;
    }

    .back-btn:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
      transform: translateX(-2px);
    }

    .page-title {
      font-family: "Sora", sans-serif;
      font-size: 20px;
    }

    .search-wrap {
      position: relative;
      flex: 1;
      max-width: 420px;
    }

    .search-input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 999px;
      outline: none;
      font-size: 14px;
    }

    .search-input:focus {
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .search-icon {
      position: absolute;
      top: 50%;
      left: 13px;
      color: var(--muted);
      transform: translateY(-50%);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-btn,
    .avatar-btn {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 50%;
    }

    .icon-btn {
      color: var(--muted);
      background: var(--white);
      border: 1px solid var(--line);
      cursor: pointer;
      font-size: 17px;
    }

    .icon-btn:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
    }

    .avatar-btn {
      color: var(--white);
      font-size: 13px;
      font-weight: 700;
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
    }

    /* Buttons */
    .btn {
      padding: 11px 18px;
      border: none;
      font-size: 13px;
    }

    .btn-primary {
      color: var(--white);
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
      box-shadow: 0 14px 40px rgba(44, 131, 248, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
    }

    .btn-outline {
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
    }

    .btn-outline:hover {
      color: var(--electric-blue);
      border-color: var(--electric-blue);
      transform: translateY(-2px);
    }

    .btn-sm {
      padding: 7px 12px;
      font-size: 12px;
    }

    /* Page */
    .page-wrap {
      padding: 28px 0 60px;
    }

    .page-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .page-heading {
      margin-bottom: 3px;
      font-family: "Sora", sans-serif;
      font-size: 27px;
      letter-spacing: -1px;
    }

    .page-sub {
      color: var(--muted);
      font-size: 13px;
    }

    .head-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Filters */
    .filters {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      padding: 16px;
      margin-bottom: 18px;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .filter-select {
      padding: 10px 14px;
      color: var(--deep-navy);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 999px;
      outline: none;
      font-size: 13px;
      font-weight: 600;
    }

    .filter-select:focus {
      border-color: var(--electric-blue);
      box-shadow: 0 0 0 4px rgba(44, 131, 248, 0.12);
    }

    .filter-reset {
      margin-left: auto;
    }

    /* Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 18px;
    }

    .stat-card,
    .panel {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .stat-card {
      padding: 18px;
      transition: 0.25s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
    }

    .stat-label {
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.7px;
      text-transform: uppercase;
    }

    .stat-value {
      font-family: "Sora", sans-serif;
      font-size: 27px;
    }

    .stat-note {
      color: var(--muted);
      font-size: 11px;
    }

    .note-up {
      color: var(--green);
    }

    .note-warning {
      color: var(--orange);
    }

    /* Table */
    .panel {
      padding: 20px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .panel-title {
      font-family: "Sora", sans-serif;
      font-size: 18px;
    }

    .panel-sub {
      color: var(--muted);
      font-size: 12px;
    }

    .ai-badge {
      padding: 5px 10px;
      color: var(--royal-blue);
      background: rgba(44, 131, 248, 0.08);
      border: 1px solid rgba(44, 131, 248, 0.25);
      border-radius: 999px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .table-wrap {
      overflow-x: auto;
    }

    .table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .table th,
    .table td {
      padding: 11px 10px;
      text-align: left;
      border-bottom: 1px solid var(--line);
    }

    .table th {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
    }

    .candidate-cell {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 190px;
    }

    .candidate-avatar {
      width: 33px;
      height: 33px;
      display: grid;
      place-items: center;
      flex: 0 0 33px;
      border-radius: 50%;
      color: var(--white);
      font-size: 11px;
      font-weight: 700;
      background: linear-gradient(
        135deg,
        var(--electric-blue),
        var(--royal-blue)
      );
    }

    .candidate-name {
      display: block;
      font-weight: 700;
    }

    .candidate-sub {
      color: var(--muted);
      font-size: 11px;
    }

    .pill {
      display: inline-flex;
      padding: 4px 9px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }

    .pill-new {
      color: var(--electric-blue);
      background: rgba(44, 131, 248, 0.1);
      border: 1px solid rgba(44, 131, 248, 0.25);
    }

    .pill-screened {
      color: var(--green);
      background: rgba(5, 150, 105, 0.1);
      border: 1px solid rgba(5, 150, 105, 0.25);
    }

    .pill-interview {
      color: var(--orange);
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.25);
    }

    .pill-offer {
      color: var(--royal-blue);
      background: rgba(39, 76, 220, 0.1);
      border: 1px solid rgba(39, 76, 220, 0.25);
    }

    .pill-rejected {
      color: var(--red);
      background: rgba(220, 38, 38, 0.1);
      border: 1px solid rgba(220, 38, 38, 0.25);
    }

    .score-high {
      color: var(--green);
    }

    .score-medium {
      color: var(--orange);
    }

    .row-actions {
      display: flex;
      gap: 6px;
    }

    .empty-state {
      display: none;
      padding: 30px 10px;
      text-align: center;
      color: var(--muted);
      font-size: 13px;
    }

    /* Animation */
    .reveal-up {
      opacity: 0;
      transform: translateY(16px);
      animation: revealUp 0.65s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }

    @keyframes revealUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .delay-1 {
      animation-delay: 0.06s;
    }

    .delay-2 {
      animation-delay: 0.12s;
    }

    .delay-3 {
      animation-delay: 0.18s;
    }

    @media (max-width: 1000px) {
      body {
        display: block;
      }

      .sidebar {
        position: relative;
        width: 100%;
        height: auto;
        border-right: none;
        border-bottom: 1px solid var(--line);
      }

      .nav-list {
        grid-template-columns: repeat(2, 1fr);
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 700px) {
      .nav-list {
        grid-template-columns: 1fr;
      }

      .topbar-inner {
        flex-wrap: wrap;
      }

      .search-wrap {
        order: 3;
        width: 100%;
        max-width: none;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .filter-reset {
        margin-left: 0;
      }
    }
  </style>
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">V</div>
      <span>VENTRIXCARROS</span>
    </div>

    <nav class="nav-list">
      <a href="dashboard.html" class="nav-item">
